---
// src/layouts/Layout.astro
// HEK75 ARCADE OS V3 — Terminal + LiteCast Retro CRT Layout.

import '../styles/arcade.css';

interface Props {
  title?: string;
  description?: string;
  activeNav?: "home" | "games" | "products" | "player" | "contact" | "none";
  footerLeft?: string;
  footerRight?: string;
}

const {
  title = "HEK75 // Arcade Portfolio",
  description = "Harun Emrecan Karabağ — Game Developer & Software Portfolio in CRT Arcade OS.",
  activeNav = "none",
  footerLeft = "HEK75 ARCADE SYSTEM // READY",
  footerRight = "HEK75 ENTERTAINMENT SYSTEM // 2026"
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isGames = activeNav === 'games' || pathname.startsWith('/projects') || pathname.startsWith('/games');
const isProducts = activeNav === 'products' || pathname.startsWith('/products');
const isPlayer = activeNav === 'player' || pathname.startsWith('/player') || pathname.startsWith('/about') || pathname.startsWith('/skills');
const isContact = activeNav === 'contact' || pathname.startsWith('/contact') || pathname.startsWith('/multiplayer');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/assets/favicon.ico" />
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="shell">
      <main class="screen">
        <!-- Arcade Topbar -->
        <header class="topbar">
          <a class="brand" href="/">HEK75 // ARCADE OS</a>
          <nav>
            {isHome ? (
              <span class="online">● ONLINE // PLAYER_01</span>
            ) : null}
            <a class={isPlayer ? "active" : ""} href="/player/">PLAYER</a>
            <a class={isGames ? "active" : ""} href="/projects/">GAMES</a>
            <a class={isProducts ? "active" : ""} href="/products/">PRODUCTS</a>
            <a class={isContact ? "active" : ""} href="/contact/">MULTIPLAYER</a>
            <button class="term-nav-btn" type="button" onclick="window.HEKTerminal?.open()" aria-label="Open Terminal">&gt;_</button>
            <button class="sound-toggle" type="button">SOUND: ON</button>
          </nav>
        </header>

        <!-- Page Specific Content -->
        <slot />

        <!-- Arcade Footer -->
        <footer class="footer">
          <span>{footerLeft}</span>
          <span>{footerRight}</span>
        </footer>
      </main>
    </div>

    <!-- Client Scripts for Sound, Search and Terminal -->
    <script is:inline src="/scripts/search-index.js"></script>
    <script is:inline src="/scripts/sound.js"></script>
    <script is:inline src="/scripts/terminal.js"></script>
  </body>
</html>
