---
// src/layouts/Layout.astro
// HEK75 ARCADE OS V3 — Terminal + LiteCast Retro CRT Layout.

import '../styles/arcade.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  type?: "website" | "profile" | "article";
  activeNav?: "home" | "games" | "products" | "player" | "contact" | "none";
  footerLeft?: string;
  footerRight?: string;
  breadcrumbs?: { name: string; url: string }[];
  customSchema?: Record<string, any>[];
}

const {
  title = "Harun Emrecan Karabağ — Unity & Unreal Engine Game Developer | HEK75 OS",
  description = "Harun Emrecan Karabağ (HEK75) — Game Developer & Software Engineer. Portfolio featuring Unity, Unreal Engine 5, C#, C++, gameplay programming case studies, and native tools.",
  keywords = "HEK75, hek75, HEK75 OS, Harun Emrecan Karabağ, Harun Emrecan Karabag, Harun Karabag, hekye, Hekyetmisbes, Game Developer, Game Programmer, Indie Game Developer, Oyun Geliştirici, Unity Developer, Unreal Engine Developer, C# Developer, C++ Gameplay, The Final Loop, The Unlit Door, Fog Bridge, LiteCast, Retro Arcade Portfolio, Hacettepe University",
  image = "/assets/og-image.svg",
  type = "website",
  activeNav = "none",
  footerLeft = "HEK75 OS // SYSTEM READY",
  footerRight = "HEK75 ENTERTAINMENT SYSTEM // 2026",
  breadcrumbs = [],
  customSchema = []
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isGames = activeNav === 'games' || pathname.startsWith('/projects') || pathname.startsWith('/games');
const isProducts = activeNav === 'products' || pathname.startsWith('/products');
const isPlayer = activeNav === 'player' || pathname.startsWith('/player') || pathname.startsWith('/about') || pathname.startsWith('/skills');
const isContact = activeNav === 'contact' || pathname.startsWith('/contact') || pathname.startsWith('/multiplayer');

const siteUrl = "https://hek75.com";
const cleanPath = pathname === '/' ? '/' : (pathname.endsWith('/') ? pathname : `${pathname}/`);
const canonicalURL = new URL(cleanPath, siteUrl).href;
const ogImageURL = new URL(image, siteUrl).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "HEK75 OS",
      "alternateName": ["HEK75", "Harun Emrecan Karabağ Portfolio", "HEK75 Arcade OS"],
      "description": "Harun Emrecan Karabağ (HEK75) — Game Developer & Software Engineer Portfolio",
      "publisher": {
        "@id": `${siteUrl}/#person`
      },
      "inLanguage": "en-US"
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      "name": "Harun Emrecan Karabağ",
      "alternateName": ["HEK75", "Harun Karabag", "hekye", "Hekyetmisbes"],
      "url": siteUrl,
      "image": `${siteUrl}/assets/Emre.png`,
      "jobTitle": "Game Developer & Software Engineer",
      "description": "Unity & Unreal Engine Game Developer, C# / C++ Gameplay Programmer, Master's student in Computer Animation and Game Technologies at Hacettepe University.",
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "Hacettepe University"
      },
      "knowsAbout": [
        "Game Development",
        "Unity",
        "Unreal Engine",
        "C#",
        "C++",
        "Gameplay Systems",
        "Game Architecture",
        "Performance Optimization",
        "Input Systems",
        "AI & Navigation",
        "Level Prototyping",
        "Shaders & Graphics"
      ],
      "sameAs": [
        "https://github.com/Hekyetmisbes",
        "https://github.com/hekye",
        "https://linkedin.com/in/harun-emrecan-karabag",
        "https://hekyetmisbes.itch.io"
      ]
    }
  ]
};

if (breadcrumbs && breadcrumbs.length > 0) {
  jsonLd["@graph"].push({
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs.map((b, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": b.name,
      "item": b.url.startsWith("http") ? b.url : `${siteUrl}${b.url}`
    }))
  } as any);
}

if (customSchema && customSchema.length > 0) {
  jsonLd["@graph"].push(...customSchema);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Icons & Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Primary Meta Tags -->
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Harun Emrecan Karabağ" />
    <meta name="creator" content="Harun Emrecan Karabağ" />
    <meta name="publisher" content="HEK75" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="theme-color" content="#020503" />
    <meta name="color-scheme" content="dark" />

    <!-- Open Graph / Facebook / LinkedIn / Discord -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="HEK75 OS" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content="HEK75 OS — Harun Emrecan Karabağ | Game Developer Portfolio" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="HEK75 OS — Harun Emrecan Karabağ | Game Developer Portfolio" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <!-- Skip to Main Content Link for Keyboard / Screen Reader Accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <div class="shell">
      <div class="screen">
        <!-- Arcade Topbar -->
        <header class="topbar">
          <a class="brand" href="/" aria-label="HEK75 OS — Harun Emrecan Karabağ Home">HEK75 OS</a>
          <nav aria-label="Main Navigation">
            {isHome ? (
              <span class="online">● ONLINE // PLAYER_01</span>
            ) : null}
            <a class={isPlayer ? "active" : ""} href="/player/" aria-label="Player Profile and Resume — About Harun Emrecan Karabağ" title="About / CV">PLAYER</a>
            <a class={isGames ? "active" : ""} href="/projects/" aria-label="Game Development Projects — Unity & Unreal Engine" title="Game Projects">GAMES</a>
            <a class={isProducts ? "active" : ""} href="/products/" aria-label="Software Products & Developer Tools" title="Software Products">PRODUCTS</a>
            <a class={isContact ? "active" : ""} href="/contact/" aria-label="Contact & Collaboration Channels — Harun Emrecan Karabağ" title="Contact & Comms">MULTIPLAYER</a>
            <button class="term-nav-btn" type="button" onclick="window.HEKTerminal?.open()" aria-label="Open Terminal">&gt;_</button>
            <button class="sound-toggle" type="button">SOUND: ON</button>
          </nav>
        </header>

        <!-- Main Content Area -->
        <main id="main-content">
          <slot />
        </main>

        <!-- Arcade Footer with Structured Navigation Links -->
        <footer class="footer">
          <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 8px;">
            <span>{footerLeft}</span>
            <span>{footerRight}</span>
          </div>
          <div class="footer-links-grid" aria-label="Footer Secondary Navigation">
            <div style="color: var(--green); font-weight: 700;">
              HARUN EMRECAN KARABAĞ // HEK75
            </div>
            <nav class="footer-nav-list" aria-label="Footer Links">
              <a href="/projects/">Projects</a>
              <a href="/player/">Player / CV</a>
              <a href="/products/">Products</a>
              <a href="/contact/">Contact</a>
              <a href="https://github.com/Hekyetmisbes" target="_blank" rel="noopener">GitHub</a>
              <a href="https://linkedin.com/in/harun-emrecan-karabag" target="_blank" rel="noopener">LinkedIn</a>
            </nav>
          </div>
        </footer>
      </div>
    </div>

    <!-- Client Scripts for Sound, Search and Terminal -->
    <script is:inline src="/scripts/search-index.js"></script>
    <script is:inline src="/scripts/sound.js"></script>
    <script is:inline src="/scripts/terminal.js"></script>
  </body>
</html>
