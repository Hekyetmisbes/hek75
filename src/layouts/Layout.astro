---
// src/layouts/Layout.astro
// English Cinematic Layout Wrapper with Non-Clipping Grid-Stacked Brand Flipper.

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Harun Emrecan Karabağ | Portfolio", 
  description = "Harun Emrecan Karabağ portfolio website." 
} = Astro.props;

const pathname = Astro.url.pathname;
const isProjects = pathname.startsWith('/projects');
const isAbout = pathname.startsWith('/about');
const isSkills = pathname.startsWith('/skills');
const isContact = pathname.startsWith('/contact');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/assets/favicon.ico" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Cinematic Header - Non-clipping Grid Stacked Flipper -->
    <header class="cinematic-header" id="navbar">
      <div class="nav-container">
        <a href="/" class="nav-brand font-sans">
          <div class="brand-flipper">
            <!-- Default State: HEK75 -->
            <div class="brand-item brand-default">
              <span class="brand-title font-serif">HEK75</span>
            </div>

            <!-- Hover State: HARUN EMRECAN KARABAĞ -->
            <div class="brand-item brand-hover">
              <span class="brand-title font-serif">HARUN EMRECAN KARABAĞ</span>
            </div>
          </div>
        </a>
        
        <!-- Desktop Menu -->
        <nav class="nav-links font-sans" aria-label="Main Menu">
          <a href="/projects/" class={isProjects ? "nav-link active" : "nav-link"}>Projects</a>
          <a href="/about/" class={isAbout ? "nav-link active" : "nav-link"}>About</a>
          <a href="/skills/" class={isSkills ? "nav-link active" : "nav-link"}>Skills</a>
          <a href="/contact/" class={isContact ? "nav-link active" : "nav-link"}>Contact</a>
        </nav>

        <!-- Mobile Toggle -->
        <button class="mobile-toggle" aria-label="Open Menu" aria-expanded="false">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
      </div>

      <!-- Mobile Dropdown -->
      <div class="mobile-dropdown" id="mobileMenu">
        <nav aria-label="Mobile Menu">
          <a href="/projects/" class={isProjects ? "mobile-link active" : "mobile-link"}>Projects</a>
          <a href="/about/" class={isAbout ? "mobile-link active" : "mobile-link"}>About</a>
          <a href="/skills/" class={isSkills ? "mobile-link active" : "mobile-link"}>Skills</a>
          <a href="/contact/" class={isContact ? "mobile-link active" : "mobile-link"}>Contact</a>
        </nav>
      </div>
    </header>

    <!-- Main Content Slot -->
    <slot />

    <!-- Delicate Minimalist Footer -->
    {pathname !== '/contact/' && pathname !== '/contact' && (
      <footer class="delicate-footer">
        <div class="container footer-inner">
          <p class="footer-quote font-serif">Stories begin with atmosphere before images.</p>
          
          <div class="socials-wrapper">
            <a href="mailto:harunemrecankarabag@gmail.com" class="social-box" aria-label="Send Email">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </a>
            <a href="https://www.linkedin.com/in/harunemrecankarabag/" target="_blank" rel="noopener noreferrer" class="social-box" aria-label="LinkedIn">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            </a>
            <a href="https://www.instagram.com/hekyetmisbes/" target="_blank" rel="noopener noreferrer" class="social-box" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </a>
            <a href="https://github.com/Hekyetmisbes" target="_blank" rel="noopener noreferrer" class="social-box" aria-label="GitHub">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            </a>
          </div>
          
          <p class="copyright-text font-sans">© 2026 HARUN EMRECAN KARABAĞ. ANKARA, TURKEY.</p>
        </div>
      </footer>
    )}

    <!-- Mobile Menu Logic -->
    <script>
      const toggleBtn = document.querySelector('.mobile-toggle');
      const mobileMenu = document.getElementById('mobileMenu');

      if (toggleBtn && mobileMenu) {
        toggleBtn.addEventListener('click', () => {
          const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
          toggleBtn.setAttribute('aria-expanded', (!isOpen).toString());
          mobileMenu.classList.toggle('open');
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --dark: #000000;              /* Pitch Black Base */
    --navy-dark: #07090e;         /* Pitch Black Surface */
    --navy-mid: #0d111a;          /* Secondary Surface */
    --navy-light: #161c28;        /* Divider Line */
    
    --pastel-blue: #7dd3fc;       /* Soft Pastel Sky Blue */
    --pastel-navy-accent: #3884f6;/* Smooth Blue Accent */
    --pastel-indigo: #a5b4fc;     /* Pastel Indigo */
    
    --white: #ffffff;
    --cream-light: #f8fafc;
    --muted: #94a3b8;             /* Muted Slate Text */
    --muted-dark: #64748b;
    --border-color: rgba(255, 255, 255, 0.14);
    --border-hover: #ffffff;

    --font-serif: Georgia, 'Playfair Display', serif;
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  /* Reset & Base Setup with Text Selection Disabled */
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    scroll-behavior: smooth;
    background: var(--dark);
    color: var(--cream-light);
    font-family: var(--font-sans);
    
    /* Disable Site-wide Text Selection */
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
  }

  body {
    line-height: 1.65;
    overflow-x: hidden;
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* Scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
  }
  ::-webkit-scrollbar-track {
    background: var(--dark);
  }
  ::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--white);
  }

  /* Container */
  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 9vh 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }
  
  .border-none {
    border-bottom: none !important;
  }

  .text-blue { color: var(--pastel-blue); }
  .text-indigo { color: var(--pastel-indigo); }
  .text-white { color: var(--white); }
  .text-muted { color: var(--muted); }
  .font-serif { font-family: var(--font-serif); }
  .font-sans { font-family: var(--font-sans); }

  /* Section Title */
  .section-title {
    font: 400 clamp(32px, 4.5vw, 56px) / 1.05 var(--font-serif);
    letter-spacing: -0.03em;
    color: var(--white);
    margin-bottom: 1.25rem;
  }

  /* Non-overflowing Header Navigation */
  .cinematic-header {
    position: fixed;
    z-index: 100;
    top: 0;
    left: 0;
    right: 0;
    padding: 16px 1.5rem;
    background: rgba(0, 0, 0, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-color);
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1140px;
    margin: 0 auto;
    width: 100%;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    text-decoration: none;
  }

  /* Robust CSS Grid Stack Flipper (Calculates width based on the longest text) */
  .brand-flipper {
    display: grid;
    grid-template-areas: "brandStack";
    overflow: hidden;
    align-items: center;
    height: 1.6rem;
  }

  .brand-item {
    grid-area: brandStack;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease;
  }

  .brand-default {
    opacity: 1;
    transform: translateY(0);
  }

  .brand-hover {
    opacity: 0;
    transform: translateY(100%);
  }

  .nav-brand:hover .brand-default {
    opacity: 0;
    transform: translateY(-100%);
  }

  .nav-brand:hover .brand-hover {
    opacity: 1;
    transform: translateY(0);
  }

  .brand-title {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--white);
  }

  .brand-hover .brand-title {
    color: var(--pastel-blue);
  }

  .brand-bullet {
    font-size: 0.65rem;
    color: var(--pastel-blue);
    opacity: 0.7;
  }

  .brand-tag {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }

  .nav-links {
    display: flex;
    gap: 1.75rem;
  }

  .nav-link {
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
    position: relative;
    padding: 0.2rem 0;
    transition: color 0.25s ease;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--white);
  }

  .nav-link.active::after, .nav-link:hover::after {
    content: "";
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--white);
  }

  /* Mobile Navigation */
  .mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    color: var(--white);
    cursor: pointer;
  }

  .mobile-dropdown {
    display: none;
    background: var(--dark);
    border-bottom: 1px solid var(--border-color);
    padding: 1rem 1.5rem;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
  }

  .mobile-dropdown.open {
    display: block;
  }

  .mobile-link {
    display: block;
    padding: 0.65rem 0;
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .mobile-link.active, .mobile-link:hover {
    color: var(--white);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.5rem;
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    border-radius: 6px;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--pastel-navy-accent);
    color: var(--white);
    border: 1px solid var(--pastel-navy-accent);
    font-weight: 700;
  }

  .btn-primary:hover {
    background: var(--white);
    color: var(--dark);
    border-color: var(--white);
    transform: translateY(-2px);
  }

  .btn-outline {
    background: var(--dark);
    border: 1px solid var(--border-color);
    color: var(--white);
  }

  .btn-outline:hover {
    border-color: var(--white);
    color: var(--white);
    transform: translateY(-2px);
  }

  /* Delicate Minimalist Footer */
  .delicate-footer {
    background: var(--dark);
    border-top: 1px solid var(--border-color);
    padding: 50px 1.5rem 35px;
    text-align: center;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 600px;
  }

  .footer-quote {
    font-size: 1.15rem;
    font-style: italic;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .socials-wrapper {
    display: flex;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .social-box {
    width: 2.5rem;
    height: 2.5rem;
    background: var(--dark);
    border: 1px solid var(--border-color);
    color: var(--muted);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
  }

  .social-box:hover {
    color: var(--white);
    border-color: var(--white);
    transform: translateY(-2px);
  }

  .copyright-text {
    font-size: 0.75rem;
    color: var(--muted-dark);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 800px) {
    .nav-links { display: none; }
    .mobile-toggle { display: block; }
    .cinematic-header { padding: 14px 1.5rem; }
    .brand-bullet, .brand-tag { display: none; }
  }
</style>
