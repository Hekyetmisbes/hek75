---
// src/pages/projects/index.astro
// HEK75 ARCADE OS — Cartridge Database / Game Library.

import Layout from '../../layouts/Layout.astro';
import { GAMES_LIST } from '../../data/games';
---

<Layout
  title="Unity & Unreal Engine Game Projects // HEK75 OS — Harun Emrecan Karabağ"
  description="Playable games, vertical slices, game jam entries, and technical gameplay programming case studies developed with Unity and Unreal Engine 5 by Harun Emrecan Karabağ (HEK75)."
  activeNav="games"
  footerLeft="SELECT A CARTRIDGE TO OPEN CASE STUDY"
  footerRight="HEK75 OS // GAMES.DB"
  breadcrumbs={[
    { name: "HOME", url: "/" },
    { name: "GAMES", url: "/projects/" }
  ]}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">HOME</a>
    <span class="breadcrumb-separator">/</span>
    <span class="breadcrumb-current">GAMES</span>
  </nav>

  <div class="section-head">
    <div>
      <div class="code">CARTRIDGE DATABASE // GAME LIBRARY // 07 TITLES</div>
      <h1>UNITY & UNREAL ENGINE GAME PROJECTS</h1>
    </div>
    <span class="meta">2023 — 2026</span>
  </div>

  <div class="grid games-grid">
    {GAMES_LIST.map((g) => (
      <article class="game-tile">
        <div class="cover">
          <img src={g.image} alt={`${g.title} — Game by Harun Emrecan Karabağ (HEK75)`} loading="lazy" />
        </div>
        <div class="tile-body">
          <div class="meta">FILE {g.number} // {g.year} // {g.engine}</div>
          <h2>{g.title}</h2>
          <p>{g.pitch}</p>
          <div class="tags">
            <span class="tag">{g.genre}</span>
            <span class="tag">{g.status}</span>
          </div>
          <a class="btn" href={`/projects/${g.slug}/`}>OPEN GAME FILE →</a>
        </div>
      </article>
    ))}
  </div>
</Layout>
