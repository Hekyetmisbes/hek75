---
// src/pages/projects/[slug].astro
// HEK75 ARCADE OS — Case Study & Game File Detail.

import Layout from '../../layouts/Layout.astro';
import { GAMES, GAMES_LIST, type GameProject } from '../../data/games';

export async function getStaticPaths() {
  return GAMES_LIST.map((game) => ({
    params: { slug: game.slug },
    props: { game }
  }));
}

interface Props {
  game: GameProject;
}

const { game: g } = Astro.props;

// Resolve in-site playback embed URL for YouTube, LinkedIn activities, and Google Drive previews
function resolveInSiteEmbed(game: GameProject): string | null {
  if (game.mediaType === "youtube" && game.mediaUrl) {
    return game.mediaUrl;
  }
  if (game.externalUrl) {
    const liMatch = game.externalUrl.match(/activity-(\d+)/);
    if (liMatch) {
      return `https://www.linkedin.com/embed/feed/update/urn:li:activity:${liMatch[1]}`;
    }
    if (game.externalUrl.includes("drive.google.com")) {
      return game.externalUrl.replace("/view?usp=drive_link", "/preview").replace("/view", "/preview");
    }
  }
  return null;
}

const inSiteEmbedUrl = resolveInSiteEmbed(g);
---

<Layout
  title={`${g.title} // Game by Harun Emrecan Karabağ — HEK75 OS`}
  description={`${g.title} (${g.year}) — ${g.genre} game developed with ${g.engine} by Harun Emrecan Karabağ (HEK75). ${g.pitch}`}
  activeNav="games"
  footerLeft="CASE STUDY MODE // GAME FILE LOADED"
  footerRight="HEK75 OS // GAMES.DB"
  image={g.image}
  type="article"
>
  <div class="detail-hero">
    <!-- Media Container -->
    {inSiteEmbedUrl ? (
      <div class="detail-cover">
        <span class="media-badge">{g.mediaType === "youtube" ? "YOUTUBE PLAYBACK" : "IN-SITE SHOWCASE"}</span>
        <iframe
          src={inSiteEmbedUrl}
          title={`${g.title} video`}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    ) : g.mediaType === "mp4" && g.mediaUrl ? (
      <div class="detail-cover">
        <span class="media-badge">LOCAL VIDEO</span>
        <video controls playsinline preload="metadata" poster={g.image}>
          <source src={g.mediaUrl} type="video/mp4" />
        </video>
      </div>
    ) : (
      <div class="detail-cover">
        <span class="media-badge">PROJECT COVER</span>
        <img src={g.image} alt={g.title} />
      </div>
    )}

    <!-- Copy & Tags -->
    <div class="detail-copy">
      <div class="code">GAME FILE // {g.number}</div>
      <h1>{g.title}</h1>
      <div class="meta">{g.genre}</div>
      <p>{g.pitch}</p>
      <div class="tags">
        <span class="tag">{g.engine}</span>
        <span class="tag">{g.year}</span>
        <span class="tag">{g.status}</span>
      </div>
      <div style="margin-top: auto; padding-top: 18px;">
        <a class="btn" href="/projects/">← RETURN TO LIBRARY</a>
      </div>
    </div>
  </div>

  <!-- Info Strip -->
  <div class="info-strip">
    <div class="info">
      <b>ENGINE</b>
      <span>{g.engine}</span>
    </div>
    <div class="info">
      <b>YEAR</b>
      <span>{g.year}</span>
    </div>
    <div class="info">
      <b>STATUS</b>
      <span>{g.status}</span>
    </div>
    <div class="info">
      <b>ROLE</b>
      <span>{g.role}</span>
    </div>
  </div>

  <!-- Content Panels -->
  <div class="content-grid">
    <section class="panel">
      <h3>[ CORE MECHANICS ]</h3>
      <ul>
        {g.mechanics.map((m) => (
          <li>{m}</li>
        ))}
      </ul>
    </section>

    <section class="panel">
      <h3>[ TECHNICAL HIGHLIGHTS ]</h3>
      <ul>
        {g.technical.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    </section>

    <section class="panel">
      <h3>[ DEVELOPMENT NOTES ]</h3>
      <p>{g.learned}</p>
    </section>

    <section class="panel">
      <h3>[ MEDIA & ACCESS ]</h3>
      <p style="margin-bottom: 14px;">
        {inSiteEmbedUrl
          ? "Interactive gameplay and showcase media embedded for direct in-site viewing."
          : "Local asset screenshots and showcase material."}
      </p>
      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        {g.links.presentation && (
          <a class="btn yellow" href={g.links.presentation} target="_blank">
            OPEN PITCH DECK ↗
          </a>
        )}
        {g.links.itch && (
          <a class="btn blue" href={g.links.itch} target="_blank" rel="noopener">
            PLAY ON ITCH.IO ↗
          </a>
        )}
        {g.links.github && (
          <a class="btn" href={g.links.github} target="_blank" rel="noopener">
            GITHUB ↗
          </a>
        )}
        {g.externalUrl && (
          <a class="btn" href={g.externalUrl} target="_blank" rel="noopener">
            EXTERNAL POST ↗
          </a>
        )}
      </div>
    </section>
  </div>

  <!-- Schema.org VideoGame Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "VideoGame",
    "name": g.title,
    "description": g.pitch,
    "genre": g.genre,
    "gamePlatform": "PC",
    "applicationCategory": "Game",
    "operatingSystem": "Windows",
    "author": {
      "@type": "Person",
      "name": "Harun Emrecan Karabağ",
      "alternateName": "HEK75",
      "url": "https://hek75.com"
    },
    "image": new URL(g.image, "https://hek75.com").href,
    "url": `https://hek75.com/projects/${g.slug}/`
  })} />
</Layout>
