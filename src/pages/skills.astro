---
// src/pages/skills.astro
// Unified & Styled Skills Page with crisp SVG Icons for Hek75.

import Layout from '../layouts/Layout.astro';
---

<Layout title="Skills | Harun Emrecan Karabağ" description="Harun Emrecan Karabağ - Game engines, programming languages, art tools, and developer skills.">
  <section class="section border-none skills-page-section">
    <div class="container">
      <small class="page-meta font-sans">TECH STACK · SKILLS</small>
      <h1 class="section-title font-serif">Skills & Technologies</h1>
      <p class="section-subtitle font-sans">Game engines, programming languages, art tools, and system architecture competencies used across my workflow.</p>

