<style>
  .skills-page-section {
    padding-top: 130px;
    padding-bottom: 90px;
  }

  .page-meta {
    letter-spacing: 0.18em;
    font-size: 0.75rem;
    color: var(--pastel-blue);
    font-weight: 600;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.35rem;
  }

  .section-subtitle {
    color: var(--muted);
    margin-top: -0.35rem;
    margin-bottom: 3.5rem;
    font-size: 1.0625rem;
  }

  .skills-categories {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .skills-category-block {
    display: flex;
    flex-direction: column;
  }

  .category-title {
    font-size: 1.4rem;
    color: var(--white);
    margin-bottom: 1.5rem;
    position: relative;
    padding-left: 0.85rem;
  }

  .category-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 14px;
    background: var(--pastel-blue);
    border-radius: 2px;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  /* Sleek Uniform Skill Item Cards */
  .skill-item {
    background: #07090e;
    border: 1px solid rgba(255, 255, 255, 0.16);
    padding: 1.6rem 1.25rem;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .skill-item:hover {
    border-color: var(--pastel-blue);
    transform: translateY(-3px);
  }

  /* Uniform 52px Circle Icon Container */
  .skill-icon-box {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.16);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.85rem;
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .skill-item:hover .skill-icon-box {
    border-color: var(--pastel-blue);
    background: rgba(96, 165, 250, 0.08);
  }

  /* All SVG icons use pastel blue by default, crisp white on hover */
  .skill-icon {
    color: var(--pastel-blue);
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .skill-item:hover .skill-icon {
    color: #ffffff;
    transform: scale(1.1);
  }

  .skill-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--white);
    letter-spacing: 0.03em;
  }

  @media (max-width: 900px) {
    .skills-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 600px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
</style>
