---
// src/pages/products/litecast.astro
// HEK75 ARCADE OS — Dedicated LiteCast Product Page & Browser Simulator.

import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="LiteCast // HEK75"
  description="Native Windows launcher and developer toolkit built with Rust and Win32/DWM."
  activeNav="products"
  footerLeft="POWERED BY RUST // NATIVE WINDOWS APIs"
  footerRight="HEK75 // LITECAST.EXE"
>
  <!-- LiteCast Hero -->
  <section class="lc-hero">
    <div class="lc-brand-row">
      <div class="lc-hero-icon">
        <img
          src="/assets/litecast/icon.png"
          alt="LiteCast"
          onerror="this.style.display='none';this.parentElement.innerHTML='<div class=&quot;product-icon-fallback&quot;>LC</div>'"
        />
      </div>
      <div>
        <div class="meta">HEK75 SOFTWARE // PRODUCT_01 // v1.0.1</div>
        <h1 class="lc-title">LITECAST</h1>
        <div class="lc-sub">Native Windows launcher // Rust + Win32/DWM</div>
      </div>
    </div>

    <p class="lc-lead">
      LiteCast is a keyboard-first Windows launcher and compact developer toolkit.
      The idea is simple: summon it, type what you need, act immediately, then get out of the way.
      The native stack keeps the launcher responsive while avoiding Electron/Chromium runtime overhead.
    </p>

    <div class="lc-pills">
      <span class="lc-pill"><b>OS</b> Windows 10 / 11 x64</span>
      <span class="lc-pill"><b>LANG</b> Rust 2024</span>
      <span class="lc-pill"><b>RAM</b> ~25–40 MB</span>
      <span class="lc-pill"><b>LATENCY</b> &lt;50ms target</span>
      <span class="lc-pill"><b>LICENSE</b> MIT / Apache 2.0</span>
    </div>

    <div class="product-actions">
      <a class="btn yellow" href="/downloads/litecast/LiteCast-Setup.exe" download>DOWNLOAD SETUP (.EXE) ↗</a>
      <a class="btn blue" href="https://github.com/Hekyetmisbes/litecast" target="_blank" rel="noopener">GITHUB REPOSITORY ↗</a>
      <a class="btn" href="/products/">← PRODUCTS</a>
    </div>
  </section>

  <!-- Interactive Simulator -->
  <div class="section-head" style="margin-top: 34px;">
    <div>
      <div class="code">INTERACTIVE BUILD</div>
      <h2>TRY LITECAST</h2>
    </div>
    <span class="meta">BROWSER SIMULATOR</span>
  </div>

  <div class="launcher-wrap">
    <div class="launcher-window" id="litecastSimulator">
      <div class="launcher-titlebar">
        <span>LiteCast // simulated native launcher</span>
        <span>ALT + SPACE</span>
      </div>

      <div class="launcher-input-row">
        <div class="launcher-mini-icon">
          <img
            src="/assets/litecast/icon.png"
            alt="LC"
            onerror="this.style.display='none';this.parentElement.textContent='LC'"
          />
        </div>

        <input
          id="lcInput"
          class="launcher-input"
          placeholder="App, site page, command (>), calculation, converter..."
          autocomplete="off"
          spellcheck="false"
        />

        <button class="launcher-settings" id="lcSettings" type="button" title="Settings">⚙</button>
      </div>

      <div class="launcher-results" id="lcResults"></div>
    </div>

    <div class="quick-row">
      <span>QUICK TRY:</span>
      <button class="quick-chip" data-q="the final loop">the final loop</button>
      <button class="quick-chip" data-q="products">products</button>
      <button class="quick-chip" data-q="rust">rust</button>
      <button class="quick-chip" data-q="(45 * 12) / 3">(45*12)/3</button>
      <button class="quick-chip" data-q="15% of 2500">15% of 2500</button>
      <button class="quick-chip" data-q="100km to mi">100km to mi</button>
      <button class="quick-chip" data-q="> help">&gt; help</button>
    </div>
  </div>

  <!-- Why LiteCast Pillars -->
  <div class="section-head" style="margin-top: 42px;">
    <div>
      <div class="code">CORE PRINCIPLES</div>
      <h2>WHY LITECAST?</h2>
    </div>
  </div>

  <div class="pillars-grid">
    <div class="pillar">
      <div class="big-metric">0%</div>
      <strong>Idle CPU mindset</strong>
      <p>Event-driven behavior designed to sleep quietly in the background.</p>
    </div>
    <div class="pillar">
      <div class="big-metric">25–40</div>
      <strong>MB RAM range</strong>
      <p>Native Rust/Win32 architecture without a bundled browser runtime.</p>
    </div>
    <div class="pillar">
      <div class="big-metric">&lt;50ms</div>
      <strong>Trigger target</strong>
      <p>Keyboard-first access intended to feel immediate when summoned.</p>
    </div>
    <div class="pillar">
      <div class="big-metric">LOCAL</div>
      <strong>Privacy-first</strong>
      <p>Search and utility workflows are designed around local execution.</p>
    </div>
  </div>

  <!-- Feature Grid -->
  <div class="section-head" style="margin-top: 42px;">
    <div>
      <div class="code">FEATURE MATRIX</div>
      <h2>TOOLKIT</h2>
    </div>
  </div>

  <div class="feature-grid">
    <article class="feature">
      <span class="feature-num">01</span>
      <h3>Fuzzy App & File Search</h3>
      <p>Search applications, shortcuts and files with typo-tolerant matching and keyboard navigation.</p>
    </article>
    <article class="feature">
      <span class="feature-num">02</span>
      <h3>Calculator & Conversions</h3>
      <p>Run quick arithmetic, percentages and common unit conversion workflows without opening another app.</p>
    </article>
    <article class="feature">
      <span class="feature-num">03</span>
      <h3>Developer Toolkit</h3>
      <p>Utilities such as UUID generation, Base64 operations, hashing and quick color inspection.</p>
    </article>
    <article class="feature">
      <span class="feature-num">04</span>
      <h3>Clipboard & Snippets</h3>
      <p>Find recent clipboard content and reusable text snippets from the same keyboard-first interface.</p>
    </article>
    <article class="feature">
      <span class="feature-num">05</span>
      <h3>Window Switcher</h3>
      <p>Filter active window titles and jump directly to a target window.</p>
    </article>
    <article class="feature">
      <span class="feature-num">06</span>
      <h3>Terminal & System Actions</h3>
      <p>Use command-style workflows for shell actions, launcher commands and system utilities.</p>
    </article>
  </div>

  <!-- Benchmarks Table -->
  <div class="section-head" style="margin-top: 42px;">
    <div>
      <div class="code">REFERENCE METRICS</div>
      <h2>NATIVE-FIRST PROFILE</h2>
    </div>
  </div>

  <div style="overflow: auto;">
    <table class="benchmark">
      <thead>
        <tr>
          <th>Benchmark Metric</th>
          <th>LiteCast (Native Rust)</th>
          <th>Heavy Desktop (Electron / Web Runtime)</th>
          <th>Performance Delta</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Idle RAM Footprint</td>
          <td class="lite">25 – 38 MB</td>
          <td>280 – 520 MB</td>
          <td class="delta">~12x Less Memory</td>
        </tr>
        <tr>
          <td>Cold Startup Time</td>
          <td class="lite">&lt; 180 ms</td>
          <td>1,400 – 2,600 ms</td>
          <td class="delta">~10x Faster Startup</td>
        </tr>
        <tr>
          <td>Summon / Hotkey Latency</td>
          <td class="lite">&lt; 16 ms (1 frame @60Hz)</td>
          <td>80 – 160 ms</td>
          <td class="delta">Instant (Zero Stutter)</td>
        </tr>
        <tr>
          <td>Binary / Install Size</td>
          <td class="lite">~12 MB</td>
          <td>180 – 350 MB</td>
          <td class="delta">~18x Smaller Disk Footprint</td>
        </tr>
        <tr>
          <td>Background Threads (Idle)</td>
          <td class="lite">4 – 6 threads</td>
          <td>28 – 45 threads</td>
          <td class="delta">Minimal OS Overhead</td>
        </tr>
        <tr>
          <td>Idle CPU Usage</td>
          <td class="lite">0.0% (True Event Sleep)</td>
          <td>0.8% – 2.5% (V8 Timers)</td>
          <td class="delta">Zero Battery Drain</td>
        </tr>
        <tr>
          <td>Runtime Architecture</td>
          <td class="lite">Rust + Direct Win32 / DWM</td>
          <td>Bundled Chromium + Node.js</td>
          <td class="delta">No Browser Engine Overhead</td>
        </tr>
        <tr>
          <td>Network &amp; Privacy at Idle</td>
          <td class="lite">0 KB/s (100% Offline / Local)</td>
          <td>Periodic Telemetry / Cloud Handshakes</td>
          <td class="delta">Complete Privacy</td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Shortcut Map -->
  <div class="section-head" style="margin-top: 42px;">
    <div>
      <div class="code">KEYBOARD MAP</div>
      <h2>SHORTCUTS</h2>
    </div>
  </div>

  <div class="key-grid">
    <div class="key-item">
      <kbd>Alt + Space</kbd>
      <span class="muted">Toggle LiteCast window.</span>
    </div>
    <div class="key-item">
      <kbd>Enter</kbd>
      <span class="muted">Open or execute selected result.</span>
    </div>
    <div class="key-item">
      <kbd>↑ / ↓</kbd>
      <span class="muted">Navigate results list.</span>
    </div>
    <div class="key-item">
      <kbd>Esc</kbd>
      <span class="muted">Dismiss the launcher.</span>
    </div>
  </div>

  <!-- Latest Release Notes Callout (v1.0.1) -->
  <div class="section-head" style="margin-top: 42px;">
    <div>
      <div class="code">RELEASE LOG // STABLE CHANNEL</div>
      <h2>LATEST RELEASE // v1.0.1</h2>
    </div>
    <span class="meta">UPDATED // FEB 2026</span>
  </div>

  <div class="panel" style="border-left: 3px solid var(--green);">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 12px;">
      <div>
        <span class="code" style="color: var(--yellow);">[ STABLE RELEASE ]</span>
        <h3 style="margin: 6px 0 2px 0; color: var(--green);">LiteCast v1.0.1 — Güvenlik, Dizinleme ve Arayüz İyileştirmeleri</h3>
      </div>
      <span class="tag" style="align-self: flex-start;">BUILD 1.0.1.0</span>
    </div>
    <p class="muted" style="line-height: 1.6; margin-bottom: 18px; font-size: 13px;">
      Windows PE sürüm bilgileri ve Authenticode (SHA-256 + DigiCert RFC-3161) kod imzalama standartları entegre edildi,
      arama dizinindeki sahte linkler temizlendi ve uygulama içi canlı bildirim (in-app toast) mimarisine geçildi.
    </p>
    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
      <a class="btn yellow" href="/products/litecast/changelog/">
        VIEW FULL CHANGELOG ↗
      </a>
      <a class="btn" href="/downloads/litecast/LiteCast-Setup.exe" download>
        DOWNLOAD SETUP (.EXE) ↗
      </a>
    </div>
  </div>
</Layout>

<script is:inline>
  (() => {
    function initSimulator() {
      const input = document.getElementById("lcInput");
      const results = document.getElementById("lcResults");
      const quick = [...document.querySelectorAll(".quick-chip")];
      if (!input || !results) return;

      let selected = 0;
      let current = [];

      const fallbackIndex = [
        { title: "The Final Loop", sub: "Unreal Engine 5 psychological puzzle vertical slice", type: "game", url: "/projects/the-final-loop/", keywords: ["unreal", "ue5", "blueprint", "puzzle", "psychological", "the final loop", "final loop", "loop"] },
        { title: "The Unlit Door", sub: "Psychological narrative mobile puzzle design", type: "game", url: "/projects/the-unlit-door/", keywords: ["unlit door", "unity", "light", "shadow", "narrative", "puzzle", "mobile"] },
        { title: "Fog Bridge", sub: "Atmospheric narrative puzzle game jam project", type: "game", url: "/projects/fog-bridge/", keywords: ["fog bridge", "unity", "game jam", "puzzle", "narrative", "atmospheric"] },
        { title: "Delivery Driver", sub: "Physics-based Unity courier and driving simulation", type: "game", url: "/projects/delivery-driver/", keywords: ["delivery driver", "unity", "driving", "simulation", "courier", "a*"] },
        { title: "The Platform", sub: "2D cyberpunk platformer built with Unity", type: "game", url: "/projects/the-platform/", keywords: ["platform", "unity 2d", "cyberpunk", "platformer", "stars"] },
        { title: "Flag Quiz Game", sub: "Educational geography quiz for mobile", type: "game", url: "/projects/flag-quiz-game/", keywords: ["flag quiz", "unity", "mobile", "firebase", "quiz"] },
        { title: "Movidle Game", sub: "Cinema guessing and deduction puzzle game", type: "game", url: "/projects/movidle-game/", keywords: ["movidle", "movie", "cinema", "wordle", "unity"] },
        { title: "Software Products", sub: "Native desktop software and developer tools", type: "product", url: "/products/", keywords: ["products", "software", "rust", "tools"] },
        { title: "LiteCast", sub: "Native Windows launcher built with Rust + Win32/DWM", type: "product", url: "/products/litecast/", keywords: ["litecast", "rust", "windows", "launcher", "win32", "dwm", "50ms"] },
        { title: "LiteCast v1.0.1 Changelog", sub: "Security, Authenticode, indexing cleanup and toast banner", type: "product", url: "/products/litecast/changelog/", keywords: ["changelog", "v1.0.1", "release notes", "update", "litecast"] },
        { title: "Player Record / CV", sub: "Education, experience, tools and certificates", type: "page", url: "/player/", keywords: ["player", "cv", "resume", "education", "experience", "hacettepe", "erciyes", "skills"] },
        { title: "Start Game Library", sub: "Explore all developed game projects", type: "page", url: "/projects/", keywords: ["games", "library", "projects", "game library"] },
        { title: "Multiplayer / Contact", sub: "Transmission channels: Email, LinkedIn, GitHub", type: "page", url: "/contact/", keywords: ["multiplayer", "contact", "email", "linkedin", "github", "instagram"] },
        { title: "Load Resume.pdf", sub: "Download or view official curriculum vitae", type: "page", url: "/assets/Resume.pdf", keywords: ["resume", "pdf", "cv", "download"] }
      ];

      function esc(s) {
        return String(s).replace(/[&<>"']/g, c => ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;"
        }[c]));
      }

      function iconFor(type) {
        const svgs = {
          game: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="4"/><path d="M6 12h4m-2-2v4m9-2h.01m3 0h.01"/></svg>`,
          product: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
          page: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
          calc: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="16" y1="14" x2="16" y2="18"/><path d="M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M8 18h.01M12 18h.01"/></svg>`,
          unit: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>`,
          command: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>`
        };
        return svgs[type] || svgs.page;
      }

      function safeMath(q) {
        const pct = q.match(/^\s*([\d.]+)\s*%\s*of\s*([\d.]+)\s*$/i);
        if (pct) {
          const val = (Number(pct[1]) / 100) * Number(pct[2]);
          return {
            title: `${pct[1]}% of ${pct[2]} = ${Number(val.toFixed(4)).toLocaleString()}`,
            sub: "Percentage calculation",
            type: "calc",
            insert: String(val)
          };
        }
        if (/^\s*[\d.]+\s*$/.test(q)) return null;
        if (!/^[\d\s()+\-*/.%]+$/.test(q)) return null;
        if (!/[+\-*/%]/.test(q)) return null;
        try {
          const value = Function(`"use strict";return (${q})`)();
          if (typeof value === "number" && Number.isFinite(value)) {
            return {
              title: `${q} = ${Number(value.toFixed(8))}`,
              sub: "Local calculator result",
              type: "calc",
              insert: String(value)
            };
          }
        } catch {}
        return null;
      }

      function unit(q) {
        let m = q.match(/^\s*([\d.]+)\s*km\s+to\s+mi\s*$/i);
        if (m) {
          const val = (Number(m[1]) * 0.621371).toFixed(2);
          return { title: `${m[1]} km = ${val} mi`, sub: "Length conversion", type: "unit", insert: `${val} mi` };
        }
        m = q.match(/^\s*([\d.]+)\s*mi\s+to\s+km\s*$/i);
        if (m) {
          const val = (Number(m[1]) / 0.621371).toFixed(2);
          return { title: `${m[1]} mi = ${val} km`, sub: "Length conversion", type: "unit", insert: `${val} km` };
        }
        m = q.match(/^\s*([\d.]+)\s*kg\s+to\s+lb\s*$/i);
        if (m) {
          const val = (Number(m[1]) * 2.20462).toFixed(2);
          return { title: `${m[1]} kg = ${val} lb`, sub: "Mass conversion", type: "unit", insert: `${val} lb` };
        }
        m = q.match(/^\s*([\d.]+)\s*lb\s+to\s+kg\s*$/i);
        if (m) {
          const val = (Number(m[1]) / 2.20462).toFixed(2);
          return { title: `${m[1]} lb = ${val} kg`, sub: "Mass conversion", type: "unit", insert: `${val} kg` };
        }
        m = q.match(/^\s*([\d.]+)\s*c\s+to\s+f\s*$/i);
        if (m) {
          const val = ((Number(m[1]) * 9/5) + 32).toFixed(1);
          return { title: `${m[1]} °C = ${val} °F`, sub: "Temperature conversion", type: "unit", insert: `${val} F` };
        }
        m = q.match(/^\s*([\d.]+)\s*f\s+to\s+c\s*$/i);
        if (m) {
          const val = (((Number(m[1]) - 32) * 5) / 9).toFixed(1);
          return { title: `${m[1]} °F = ${val} °C`, sub: "Temperature conversion", type: "unit", insert: `${val} C` };
        }
        return null;
      }

      function command(q) {
        if (!q.startsWith(">")) return null;
        const c = q.slice(1).trim().toLowerCase();
        const map = {
          help: "Available: > help, > reindex, > autostart, > quit, > clear",
          reindex: "Simulation: Local index refreshed (14 entries).",
          autostart: "Simulation: Autostart on Windows boot enabled.",
          quit: "Simulation: LiteCast minimized to system tray.",
          clear: "Input cleared."
        };
        return {
          title: map[c] || `Unknown command: > ${c} (Try '> help')`,
          sub: "LiteCast shell utility",
          type: "command"
        };
      }

      function site(q) {
        const pool = (typeof window !== "undefined" && window.SITE_INDEX && window.SITE_INDEX.length)
          ? window.SITE_INDEX
          : fallbackIndex;

        const tokens = q.toLowerCase().split(/\s+/).filter(Boolean);
        if (!tokens.length) return [];

        const scored = pool.map(item => {
          const hay = [
            item.title,
            item.sub || item.description || "",
            item.type || "",
            ...(item.keywords || [])
          ].join(" ").toLowerCase();

          let score = 0;
          if (item.title.toLowerCase().startsWith(q.toLowerCase())) score += 30;
          if (item.title.toLowerCase().includes(q.toLowerCase())) score += 15;

          tokens.forEach(t => {
            if (item.title.toLowerCase().includes(t)) score += 8;
            if (hay.includes(t)) score += 3;
          });

          return { item, score };
        })
        .filter(x => x.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 6)
        .map(x => ({
          title: x.item.title,
          sub: x.item.sub || x.item.description || "",
          type: x.item.type || "page",
          url: x.item.url
        }));

        return scored;
      }

      function build(q) {
        q = q.trim();
        if (!q) {
          return [
            { title: "Start typing to search HEK75", sub: "Pages, games, products, calculations and conversions.", type: "page" },
            { title: "The Final Loop", sub: "Unreal Engine 5 psychological puzzle vertical slice", type: "game", url: "/projects/the-final-loop/" },
            { title: "Products", sub: "Native software & developer tools", type: "product", url: "/products/" },
            { title: "LiteCast", sub: "Rust + Win32 native launcher", type: "product", url: "/products/litecast/" }
          ];
        }

        const cmdRes = command(q);
        if (cmdRes) return [cmdRes];

        const mathRes = safeMath(q);
        const unitRes = unit(q);
        const siteMatches = site(q);

        const list = [];
        if (mathRes) list.push(mathRes);
        if (unitRes) list.push(unitRes);
        list.push(...siteMatches);

        return list;
      }

      function render() {
        current = build(input.value);
        selected = Math.min(selected, Math.max(0, current.length - 1));

        if (!current.length) {
          results.innerHTML = '<div class="launch-empty">NO RESULTS MATCHED<br><br>Try searching: "the final loop", "rust", "products", a math equation "(45*12)/3", or a unit "100km to mi".</div>';
          return;
        }

        results.innerHTML = current.map((r, i) => `
          <div class="launch-result ${i === selected ? "selected" : ""}" data-i="${i}">
            <div class="result-icon">${iconFor(r.type)}</div>
            <div>
              <div class="result-title">${esc(r.title)}</div>
              <div class="result-sub">${esc(r.sub || "")}</div>
            </div>
            <div class="result-action">${r.url ? "OPEN ↵" : (r.insert ? "COPY ↵" : "RESULT")}</div>
          </div>
        `).join("");

        results.querySelectorAll(".launch-result").forEach(el => {
          el.addEventListener("mouseenter", () => {
            selected = Number(el.dataset.i);
            const prev = results.querySelector(".launch-result.selected");
            if (prev) prev.classList.remove("selected");
            el.classList.add("selected");
          });
          el.addEventListener("click", () => activate(Number(el.dataset.i)));
        });
      }

      function activate(i = selected) {
        const r = current[i];
        if (!r) return;
        window.hek75Sound?.beep?.(680, 0.04, "triangle", 0.015);
        if (r.url) {
          location.href = r.url;
        } else if (r.insert) {
          input.value = r.insert;
          selected = 0;
          render();
        }
      }

      input.addEventListener("input", () => {
        selected = 0;
        render();
      });

      input.addEventListener("keydown", e => {
        if (e.key === "ArrowDown") {
          e.preventDefault();
          selected = (selected + 1) % Math.max(1, current.length);
          render();
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          selected = (selected - 1 + Math.max(1, current.length)) % Math.max(1, current.length);
          render();
        } else if (e.key === "Enter") {
          e.preventDefault();
          activate();
        } else if (e.key === "Escape") {
          input.value = "";
          selected = 0;
          render();
        }
      });

      quick.forEach(b => b.addEventListener("click", () => {
        const query = b.dataset.q || b.textContent.trim();
        input.value = query;
        input.focus();
        selected = 0;
        render();
        window.hek75Sound?.beep?.(480, 0.03, "square", 0.012);
      }));

      const settingsBtn = document.getElementById("lcSettings");
      if (settingsBtn) {
        settingsBtn.addEventListener("click", () => {
          input.value = "> help";
          input.focus();
          render();
        });
      }

      render();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSimulator);
    } else {
      initSimulator();
    }

    document.addEventListener("astro:page-load", initSimulator);
  })();
</script>
