<!-- Client Script: Working Site-Wide Search & Live Calculator Engine -->
<script>
  interface LauncherItem {
    title: string;
    subtitle?: string;
    tag: string;
    url?: string;
    val?: string | number;
    keywords?: string[];
  }

  // Complete Database of Site Pages, Projects, and Standard Desktop Apps
  const defaultApps: LauncherItem[] = [
    { title: "WhatsApp Web", subtitle: "Desktop Messaging App", tag: "App", keywords: ["wa", "chat", "message"] },
    { title: "Unity Hub", subtitle: "Unity Game Engine Project Manager", tag: "App", keywords: ["unity", "gamedev", "editor"] },
    { title: "PC Manager", subtitle: "Windows System Optimization", tag: "App", keywords: ["system", "clean", "boost"] },
    { title: "Football Manager 2024", subtitle: "Sports Strategy Simulation", tag: "App", keywords: ["fm", "game", "football"] },
    { title: "Steam", subtitle: "Valve Gaming Platform", tag: "App", keywords: ["st", "games", "store"] }
  ];

  const searchableDatabase: LauncherItem[] = [
    ...defaultApps,
    { title: "Spotify", subtitle: "Music & Podcast Streaming", tag: "App", keywords: ["sp", "music", "audio"] },
    { title: "Visual Studio Code", subtitle: "Code Editor & IDE", tag: "App", keywords: ["code", "vs", "editor"] },
    { title: "Discord", subtitle: "Gaming & Community Voice Chat", tag: "App", keywords: ["dc", "voice", "chat"] },
    { title: "Command Prompt (CMD)", subtitle: "Windows Command Line", tag: "System", keywords: ["cmd", "terminal", "cli"] },
    { title: "PowerShell", subtitle: "Windows Automation Shell", tag: "System", keywords: ["ps", "terminal", "shell"] },
    { title: "Snipping Tool", subtitle: "Windows Screenshot Utility", tag: "System", keywords: ["snip", "screenshot"] },

    // Real Portfolio Pages & Projects (Clicking navigates to page!)
    { title: "The Final Loop", subtitle: "Procedural 3D Roguelite Game", tag: "Project", url: "/projects/the-final-loop/", keywords: ["game", "unity", "roguelite", "loop"] },
    { title: "The Unlit Door", subtitle: "Atmospheric Psychological Horror", tag: "Project", url: "/projects/the-unlit-door/", keywords: ["game", "horror", "unity", "story"] },
    { title: "Fog Bridge", subtitle: "Co-op Physics Survival Game", tag: "Project", url: "/projects/fog-bridge/", keywords: ["game", "survival", "physics", "multiplayer"] },
    { title: "Delivery Driver", subtitle: "Arcade 2D Physics Simulator", tag: "Project", url: "/projects/delivery-driver/", keywords: ["game", "2d", "arcade", "unity"] },
    { title: "The Platform", subtitle: "Precision 2D Platformer", tag: "Project", url: "/projects/the-platform/", keywords: ["game", "platformer"] },
    { title: "Flag Quiz Game", subtitle: "Interactive Educational Geography Game", tag: "Project", url: "/projects/flag-quiz-game/", keywords: ["game", "quiz", "trivia"] },
    { title: "Movidle Game", subtitle: "Daily Cinema Guessing Game", tag: "Project", url: "/projects/movidle-game/", keywords: ["game", "wordle", "movie"] },
    { title: "Projects Catalog", subtitle: "Browse all portfolio games & software", tag: "Page", url: "/projects/", keywords: ["games", "portfolio", "work"] },
    { title: "About Me", subtitle: "Background, Experience & Philosophy", tag: "Page", url: "/about/", keywords: ["bio", "harun", "resume", "experience"] },
    { title: "Skills & Tech Stack", subtitle: "Game Engines, Languages & Frameworks", tag: "Page", url: "/skills/", keywords: ["unity", "unreal", "c++", "c#", "rust", "react", "astro"] },
    { title: "Contact & Inquiries", subtitle: "Get in touch or collaborate", tag: "Page", url: "/contact/", keywords: ["email", "message", "hire", "socials"] },
    { title: "Products Suite", subtitle: "Desktop applications & tools catalog", tag: "Page", url: "/products/", keywords: ["software", "apps", "tools"] },
    { title: "LiteCast Product Page", subtitle: "Ultra-Lightweight Windows Launcher", tag: "Page", url: "/products/litecast/", keywords: ["litecast", "launcher", "rust"] },
    { title: "Download LiteCast Setup (.exe)", subtitle: "Direct Windows Installer Download", tag: "Download", url: "/downloads/litecast/LiteCast-Setup.exe", keywords: ["install", "setup", "download", "exe"] },
    { title: "LiteCast GitHub Repository", subtitle: "Source code & Rust implementation", tag: "GitHub", url: "https://github.com/Hekyetmisbes/litecast", keywords: ["repo", "git", "source"] }
  ];

  // Mathematical & Unit Converter Calculation Engine
  function evaluateCalculation(query: string): LauncherItem | null {
    try {
      const expr = query.trim();
      if (!expr) return null;

      // 1. Percentage check: "15% of 2500" or "18% 250"
      const pctMatch = expr.match(/^(\d+(?:\.\d+)?)\s*%\s*(?:of\s*)?(\d+(?:\.\d+)?)$/i);
      if (pctMatch) {
        const val = (parseFloat(pctMatch[1]) / 100) * parseFloat(pctMatch[2]);
        return { title: `= ${val}`, subtitle: `${pctMatch[1]}% of ${pctMatch[2]} = ${val}`, tag: "Math", val };
      }

      // 2. Physical Unit & Currency Conversions
      const unitMatch = expr.match(/^(\d+(?:\.\d+)?)\s*([a-zA-Z°]+)\s*(?:to|in)\s*([a-zA-Z°]+)$/i);
      if (unitMatch) {
        const n = parseFloat(unitMatch[1]);
        const from = unitMatch[2].toLowerCase();
        const to = unitMatch[3].toLowerCase();

        if ((from === 'km' || from === 'kilometers') && (to === 'mi' || to === 'miles' || to === 'mile')) {
          const res = (n * 0.621371).toFixed(4);
          return { title: `${res} miles`, subtitle: `${n} km = ${res} miles`, tag: "Converter", val: res };
        }
        if ((from === 'mi' || from === 'miles' || from === 'mile') && (to === 'km' || to === 'kilometers')) {
          const res = (n * 1.60934).toFixed(4);
          return { title: `${res} km`, subtitle: `${n} miles = ${res} km`, tag: "Converter", val: res };
        }
        if ((from === 'm' || from === 'meters') && (to === 'ft' || to === 'feet')) {
          const res = (n * 3.28084).toFixed(4);
          return { title: `${res} ft`, subtitle: `${n} m = ${res} ft`, tag: "Converter", val: res };
        }
        if ((from === 'ft' || from === 'feet') && (to === 'm' || to === 'meters')) {
          const res = (n * 0.3048).toFixed(4);
          return { title: `${res} m`, subtitle: `${n} ft = ${res} m`, tag: "Converter", val: res };
        }
        if ((from === 'kg' || from === 'kilos') && (to === 'lb' || to === 'lbs' || to === 'pounds')) {
          const res = (n * 2.20462).toFixed(4);
          return { title: `${res} lbs`, subtitle: `${n} kg = ${res} lbs`, tag: "Converter", val: res };
        }
        if ((from === 'lb' || from === 'lbs' || from === 'pounds') && (to === 'kg' || to === 'kilos')) {
          const res = (n * 0.453592).toFixed(4);
          return { title: `${res} kg`, subtitle: `${n} lbs = ${res} kg`, tag: "Converter", val: res };
        }
        if ((from === 'c' || from === 'celsius' || from === '°c') && (to === 'f' || to === 'fahrenheit' || to === '°f')) {
          const res = ((n * 9 / 5) + 32).toFixed(2);
          return { title: `${res} °F`, subtitle: `${n}°C = ${res}°F`, tag: "Converter", val: res };
        }
        if ((from === 'f' || from === 'fahrenheit' || from === '°f') && (to === 'c' || to === 'celsius' || to === '°c')) {
          const res = (((n - 32) * 5) / 9).toFixed(2);
          return { title: `${res} °C`, subtitle: `${n}°F = ${res}°C`, tag: "Converter", val: res };
        }
        if (from === 'gb' && to === 'mb') {
          const res = n * 1024;
          return { title: `${res} MB`, subtitle: `${n} GB = ${res} MB`, tag: "Converter", val: res };
        }
        if (from === 'mb' && to === 'gb') {
          const res = (n / 1024).toFixed(3);
          return { title: `${res} GB`, subtitle: `${n} MB = ${res} GB`, tag: "Converter", val: res };
        }
        if (from === 'usd' && to === 'eur') {
          const res = (n * 0.92).toFixed(2);
          return { title: `${res} EUR`, subtitle: `${n} USD = ${res} EUR`, tag: "Currency", val: res };
        }
        if (from === 'eur' && to === 'usd') {
          const res = (n * 1.09).toFixed(2);
          return { title: `${res} USD`, subtitle: `${n} EUR = ${res} USD`, tag: "Currency", val: res };
        }
        if (from === 'usd' && to === 'try') {
          const res = (n * 34.2).toFixed(2);
          return { title: `${res} TRY`, subtitle: `${n} USD = ${res} TRY`, tag: "Currency", val: res };
        }
        if (from === 'btc' && to === 'usd') {
          const res = (n * 64500).toLocaleString();
          return { title: `$${res} USD`, subtitle: `${n} BTC ≈ $${res}`, tag: "Crypto", val: res };
        }
      }

      // 3. DevTools: Base64, UUID, Color Hex
      if (expr.toLowerCase().startsWith('b64 encode ')) {
        const text = expr.substring(11);
        const res = btoa(text);
        return { title: res, subtitle: `Base64 Encoded (${text})`, tag: "Base64", val: res };
      }
      if (expr.toLowerCase().startsWith('b64 decode ')) {
        const text = expr.substring(11);
        try {
          const res = atob(text);
          return { title: res, subtitle: `Base64 Decoded (${text})`, tag: "Base64", val: res };
        } catch (e) {}
      }
      if (expr.toLowerCase() === 'uuid' || expr.toLowerCase() === 'guid') {
        const res = typeof crypto !== 'undefined' && crypto.randomUUID ? crypto.randomUUID() : '4f8c9b2e-71a3-4c90-b18d-905e3f5a2b10';
        return { title: res, subtitle: "UUID v4 Unique Identifier", tag: "UUID", val: res };
      }
      if (expr.startsWith('#') && (expr.length === 4 || expr.length === 7)) {
        let hex = expr.substring(1);
        if (hex.length === 3) hex = hex.split('').map(c => c + c).join('');
        const r = parseInt(hex.substring(0, 2), 16);
        const g = parseInt(hex.substring(2, 4), 16);
        const b = parseInt(hex.substring(4, 6), 16);
        if (!isNaN(r) && !isNaN(g) && !isNaN(b)) {
          const rgb = `rgb(${r}, ${g}, ${b})`;
          return { title: rgb, subtitle: `HEX ${expr.toUpperCase()} ➔ ${rgb}`, tag: "Color", val: rgb };
        }
      }

      // 4. Mathematical Expressions Evaluator
      const isMathChars = /^[0-9\.\s\+\-\*\/\(\)\^\%\,a-zA-Z]+$/;
      if (isMathChars.test(expr) && /[0-9]/.test(expr) && /[\+\-\*\/\^]|\bsqrt\b|\bsin\b|\bcos\b|\btan\b|\blog\b|\babs\b|\bpi\b|\be\b/i.test(expr)) {
        const sanitized = expr
          .replace(/\^/g, '**')
          .replace(/\bsqrt\b/gi, 'Math.sqrt')
          .replace(/\bsin\b/gi, 'Math.sin')
          .replace(/\bcos\b/gi, 'Math.cos')
          .replace(/\btan\b/gi, 'Math.tan')
          .replace(/\blog\b/gi, 'Math.log10')
          .replace(/\babs\b/gi, 'Math.abs')
          .replace(/\bpi\b/gi, 'Math.PI')
          .replace(/\be\b/gi, 'Math.E');

        const result = Function(`'use strict'; return (${sanitized})`)();
        if (typeof result === 'number' && !isNaN(result) && isFinite(result)) {
          const formatted = Math.abs(result) < 0.00001 ? result : Number(result.toFixed(6));
          return { title: `= ${formatted}`, subtitle: `${expr} = ${formatted}`, tag: "Calculator", val: formatted };
        }
      }
    } catch (err) {}
    return null;
  }

  // DOM Elements
  const input = document.getElementById('simQueryInput') as HTMLInputElement;
  const resultsContainer = document.getElementById('simResultsContainer');
  const toast = document.getElementById('simToast');
  const btnCopy = document.getElementById('btnCopyCargo');
  const cargoCode = document.getElementById('cargoCode');

  let currentItems: LauncherItem[] = [];
  let selectedIndex = 0;

  function showToast(msg: string) {
    if (!toast) return;
    toast.innerText = msg;
    toast.classList.add('show');
    setTimeout(() => {
      toast.classList.remove('show');
    }, 2000);
  }

  function executeItem(item: LauncherItem) {
    if (item.url) {
      if (item.url.startsWith('/')) {
        window.location.href = item.url;
      } else {
        window.open(item.url, '_blank');
      }
      return;
    }

    if (item.val !== undefined || item.tag === 'Calculator' || item.tag === 'Converter' || item.tag === 'Base64' || item.tag === 'UUID') {
      const copyVal = String(item.val !== undefined ? item.val : item.title.replace(/^=\s*/, ''));
      navigator.clipboard.writeText(copyVal).then(() => {
        showToast(`Copied "${copyVal}" to clipboard! ✓`);
      });
      return;
    }

    showToast(`Launched: ${item.title}`);
  }

  function renderList(items: LauncherItem[]) {
    if (!resultsContainer) return;
    currentItems = items;
    if (selectedIndex >= items.length) selectedIndex = 0;

    if (items.length === 0) {
      resultsContainer.innerHTML = `
        <div class="launcher-empty font-sans">
          <span>No matching results found for this query</span>
        </div>
      `;
      return;
    }

    resultsContainer.innerHTML = items.map((item, idx) => `
      <div class="launcher-item ${idx === selectedIndex ? 'active' : ''}" data-idx="${idx}">
        <div class="item-title-wrap">
          <span class="item-title">${item.title}</span>
          ${item.subtitle ? `<span class="item-subtitle">${item.subtitle}</span>` : ''}
        </div>
        <span class="item-tag">${item.tag}</span>
      </div>
    `).join('');

    // Attach click handlers
    document.querySelectorAll('.launcher-item').forEach((el) => {
      el.addEventListener('click', () => {
        const idx = parseInt(el.getAttribute('data-idx') || '0', 10);
        selectedIndex = idx;
        renderSelection();
        executeItem(currentItems[idx]);
      });
    });
  }

  function renderSelection() {
    document.querySelectorAll('.launcher-item').forEach((el, idx) => {
      if (idx === selectedIndex) {
        el.classList.add('active');
      } else {
        el.classList.remove('active');
      }
    });
  }

  function filterResults(query: string) {
    const q = query.trim().toLowerCase();
    
    // Check if query produces a live calculation / conversion / tool result
    const calcResult = evaluateCalculation(query);
    const results: LauncherItem[] = [];

    if (calcResult) {
      results.push(calcResult);
    }

    if (!q) {
      // Default state: 5 clean items, exactly fitting the box without scroll
      currentItems = defaultApps.slice(0, 5);
      renderList(currentItems);
      return;
    }

    // Subsequence fuzzy match against database
    const matches = searchableDatabase.filter(item => {
      const titleLower = item.title.toLowerCase();
      const subLower = (item.subtitle || '').toLowerCase();
      const keywords = (item.keywords || []).join(' ');

      if (titleLower.includes(q) || subLower.includes(q) || keywords.includes(q)) return true;

      // Subsequence match
      let qi = 0;
      for (let i = 0; i < titleLower.length && qi < q.length; i++) {
        if (titleLower[i] === q[qi]) qi++;
      }
      return qi === q.length;
    });

    results.push(...matches);

    if (results.length === 0) {
      results.push({
        title: `Search Web for "${query}"`,
        subtitle: "Open search in default browser",
        tag: "Web",
        url: `https://www.google.com/search?q=${encodeURIComponent(query)}`
      });
    }

    // Cap to 5 items to keep height stable and avoid scrollbar
    renderList(results.slice(0, 5));
  }

  if (input) {
    input.addEventListener('input', () => {
      selectedIndex = 0;
      filterResults(input.value);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (currentItems.length > 0) {
          selectedIndex = (selectedIndex + 1) % currentItems.length;
          renderSelection();
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (currentItems.length > 0) {
          selectedIndex = (selectedIndex - 1 + currentItems.length) % currentItems.length;
          renderSelection();
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (currentItems.length > 0 && currentItems[selectedIndex]) {
          executeItem(currentItems[selectedIndex]);
        }
      } else if (e.key === 'Escape') {
        input.value = '';
        selectedIndex = 0;
        filterResults('');
      }
    });
  }

  // Quick query clickable chips
  document.querySelectorAll('.quick-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const q = chip.getAttribute('data-q') || '';
      if (input) {
        input.value = q;
        selectedIndex = 0;
        filterResults(q);
        input.focus();
      }
    });
  });

  // Copy code handler
  if (btnCopy && cargoCode) {
    btnCopy.addEventListener('click', () => {
      navigator.clipboard.writeText(cargoCode.innerText).then(() => {
        btnCopy.innerText = 'Copied! ✓';
        setTimeout(() => {
          btnCopy.innerText = 'Copy';
        }, 2000);
      });
    });
  }

  // Initial render matching actual LiteCast screenshot
  filterResults('');
</script>

