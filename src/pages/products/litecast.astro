---
// src/pages/products/litecast.astro
// Comprehensive English Product Page for LiteCast — Ultra-fast, lightweight Rust native Windows launcher.

import Layout from '../../layouts/Layout.astro';

const specs = [
  { label: "OS", val: "Windows 10 / 11 (x64)" },
  { label: "Language", val: "Rust 2024" },
  { label: "RAM", val: "~25-40 MB" },
  { label: "Latency", val: "< 50ms" },
  { label: "License", val: "MIT / Apache 2.0" }
];

const pillars = [
  {
    iconType: "cpu",
    title: "0% Idle CPU Overhead",
    desc: "Uses native OS event-driven sleep cycles to consume zero background CPU and preserve battery life."
  },
  {
    iconType: "ram",
    title: "~25 - 40 MB Memory",
    desc: "Pure Rust and native Win32 memory management with zero Electron, Chromium, or WebView2 runtime bloat."
  },
  {
    iconType: "zap",
    title: "< 50ms Instant Response",
    desc: "Appears instantaneously the millisecond Alt + Space is triggered, with full keyboard focus ready."
  },
  {
    iconType: "shield",
    title: "100% Offline & Private",
    desc: "Zero telemetry and zero network requests. All indexing, math, and conversions execute strictly locally."
  }
];

const features = [
  {
    num: "01",
    iconType: "search",
    title: "Fuzzy App & File Search",
    desc: "Subsequence fuzzy search across Start Menu, Desktop, and files with typo tolerance and instant aliases (sp, gh, dc)."
  },
  {
    num: "02",
    iconType: "calc",
    title: "Live Calculator & Units",
    desc: "Instant math formula evaluation, percentages, live currency rates (USD to EUR), and physical unit conversions (km to mi)."
  },
  {
    num: "03",
    iconType: "tools",
    title: "Developer Toolkit",
    desc: "Base64 encode/decode, live UUID v4 generator, MD5/SHA-256 hashing, and instant Hex-to-RGB color inspector."
  },
  {
    num: "04",
    iconType: "clipboard",
    title: "Clipboard & Snippets",
    desc: "Encrypted in-memory clipboard history tracking with instant search, re-paste, and customizable boilerplate text snippets."
  },
  {
    num: "05",
    iconType: "window",
    title: "Keyboard Window Switcher",
    desc: "Jump straight to any active desktop window via title fuzzy filtering without lifting your hands from the keyboard."
  },
  {
    num: "06",
    iconType: "terminal",
    title: "Terminal & System Actions",
    desc: "Execute PowerShell or CMD commands directly with > and trigger system actions (Lock, Sleep, Empty Recycle Bin)."
  }
];

const benchmarks = [
  {
    criterion: "Technology Stack",
    litecast: "Rust + Win32 GDI/DWM",
    raycast: "C# / WPF / Native",
    electron: "JS / Electron / Chromium"
  },
  {
    criterion: "Idle RAM Usage",
    litecast: "~25 – 40 MB",
    raycast: "~150 – 350 MB",
    electron: "~300 – 700 MB"
  },
  {
    criterion: "Idle CPU Usage",
    litecast: "0.0%",
    raycast: "0.5% – 2.0%",
    electron: "1.0% – 5.0%"
  },
  {
    criterion: "Trigger Latency",
    litecast: "< 50 ms (Instant)",
    raycast: "~100 – 200 ms",
    electron: "~300 – 800 ms"
  },
  {
    criterion: "Binary Size",
    litecast: "~1.5 MB (Single EXE)",
    raycast: "~150 – 300 MB",
    electron: "~100 – 250 MB"
  },
  {
    criterion: "Telemetry / Cloud",
    litecast: "0% Offline (Private)",
    raycast: "Partial Cloud / Telemetry",
    electron: "Mostly Online / Telemetry"
  }
];

const shortcuts = [
  { key: "Alt + Space", desc: "Toggle LiteCast from anywhere." },
  { key: "Enter", desc: "Launch app, navigate page, or copy result." },
  { key: "Up / Down", desc: "Navigate search items." },
  { key: "Esc", desc: "Dismiss launcher." }
];

const aliases = [
  { alias: "yt", target: "YouTube" },
  { alias: "sp", target: "Spotify" },
  { alias: "dc", target: "Discord" },
  { alias: "st", target: "Steam" },
  { alias: "gh", target: "GitHub" },
  { alias: "calc", target: "Calculator" },
  { alias: "code", target: "VS Code" },
  { alias: "cmd", target: "Command Prompt" }
];

const internalCmds = [
  { cmd: "help", desc: "Open help manual." },
  { cmd: "autostart", desc: "Toggle startup with Windows." },
  { cmd: "reindex", desc: "Force re-index applications." },
  { cmd: "quit", desc: "Exit LiteCast process." }
];
---

<Layout title="LiteCast | Ultra-Lightweight Native Windows Launcher" description="High-performance, bloat-free Windows application launcher and developer toolkit built with pure Rust and Win32/DWM APIs.">
  <article class="litecast-page">
    
    <!-- Top Breadcrumbs Navigation Bar -->
    <header class="litecast-nav-bar">
      <div class="container nav-inner">
        <div class="breadcrumbs font-sans">
          <a href="/products/" class="crumb-link">← Products</a>
          <span class="crumb-sep">/</span>
          <span class="crumb-current">LiteCast</span>
        </div>
        <div class="nav-extra font-sans">
          <span class="hotkey-pill"><kbd>Alt</kbd> + <kbd>Space</kbd></span>
        </div>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="hero-section">
      <div class="container">
        <div class="hero-content">
          <!-- Brand Header -->
          <div class="hero-brand-row">
            <div class="hero-logo-box">
              <img src="/assets/litecast/icon.png" alt="LiteCast Logo" class="hero-logo" />
            </div>
            <div class="hero-title-group">
              <div class="title-with-badge">
                <h1 class="hero-title font-serif">LiteCast</h1>
                <span class="version-tag font-sans">v1.0.0</span>
              </div>
              <p class="hero-subtitle font-sans">Ultra-Lightweight & Blazing-Fast Native Windows Launcher</p>
            </div>
          </div>

          <!-- Refined, concise lead paragraph -->
          <p class="hero-lead font-sans">
            A keyboard-first native Windows launcher and developer toolkit engineered with pure <strong>Rust</strong> and <strong>Win32/DWM</strong> APIs. Delivers sub-50ms instant response with zero web runtime bloat.
          </p>

          <!-- Single-line specs strip (no awkward wrapping) -->
          <div class="specs-strip font-sans">
            {specs.map((s) => (
              <div class="spec-pill">
                <span class="spec-lbl">{s.label}:</span>
                <span class="spec-val">{s.val}</span>
              </div>
            ))}
          </div>

          <!-- Delicate & proportional action buttons -->
          <div class="hero-actions font-sans">
            <a href="/downloads/litecast/LiteCast-Setup.exe" class="btn-delicate btn-delicate-primary" download>
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              Download Setup (.exe)
            </a>
            <a href="https://github.com/Hekyetmisbes/litecast" target="_blank" rel="noopener noreferrer" class="btn-delicate btn-delicate-outline">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
              GitHub Repository ↗
            </a>
          </div>
        </div>

        <!-- Authentic Native LiteCast Window Simulator (Matches Real App UI) -->
        <div class="native-launcher-container">
          <div class="native-launcher-window" id="litecastSimulator">
            <!-- Top Input Row with App Icon, Input, Settings Button -->
            <div class="launcher-input-row">
              <div class="launcher-app-icon">
                <img src="/assets/litecast/icon.png" alt="LiteCast" class="lc-icon" />
              </div>
              <input 
                type="text" 
                id="simQueryInput" 
                class="launcher-input font-sans" 
                placeholder="App, site page, file (C:\), command (>), converter (100km to mi)..." 
                autocomplete="off" 
                spellcheck="false" 
              />
              <button class="launcher-settings-btn" id="btnSimSettings" title="LiteCast Settings" aria-label="Settings">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
              </button>
            </div>

            <!-- Toast alert for live clipboard copy -->
            <div class="launcher-toast font-sans" id="simToast">Copied to clipboard!</div>

            <!-- List Results Container matching actual LiteCast UI (5 clean items, no scroll) -->
            <div class="launcher-results-list font-sans" id="simResultsContainer"></div>
          </div>
          
          <!-- Elegant Interactive Quick-Query Suggestion Strip -->
          <div class="launcher-quick-queries font-sans">
            <span class="quick-title">Quick Try:</span>
            <div class="quick-chips">
              <button type="button" class="quick-chip" data-q="the final loop">the final loop</button>
              <button type="button" class="quick-chip" data-q="skills">skills</button>
              <button type="button" class="quick-chip" data-q="about">about</button>
              <button type="button" class="quick-chip" data-q="(45 * 12) / 3">(45*12)/3</button>
              <button type="button" class="quick-chip" data-q="15% of 2500">15% of 2500</button>
              <button type="button" class="quick-chip" data-q="100km to mi">100km to mi</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Pillars (4 symmetric cards) -->
    <section class="section summary-section">
      <div class="container">
        <div class="section-title-wrap">
          <small class="page-meta font-sans">CORE PRINCIPLES</small>
          <h2 class="section-heading font-serif">Why LiteCast?</h2>
          <p class="section-intro font-sans">
            Built from the ground up using <strong>Rust</strong> and raw <strong>Win32/DWM</strong> APIs to eliminate heavy Chromium and Electron runtimes.
          </p>
        </div>

        <div class="pillars-grid font-sans">
          {pillars.map((p) => (
            <div class="pillar-card">
              <div class="pillar-icon-box">
                {p.iconType === "cpu" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></svg>
                )}
                {p.iconType === "ram" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 19v-3M10 19v-7M14 19v-4M18 19v-8M6 5v1M10 5v1M14 5v1M18 5v1"></path><rect x="2" y="5" width="20" height="14" rx="2"></rect></svg>
                )}
                {p.iconType === "zap" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                )}
                {p.iconType === "shield" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                )}
              </div>
              <h3 class="pillar-title font-serif">{p.title}</h3>
              <p class="pillar-desc">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Concise Core Capabilities (6 balanced cards in a 3-column grid) -->
    <section class="section features-section">
      <div class="container">
        <div class="section-title-wrap">
          <small class="page-meta font-sans">CORE CAPABILITIES</small>
          <h2 class="section-heading font-serif">Key Modules</h2>
          <p class="section-intro font-sans">
            Six essential native modules designed for rapid keyboard-driven productivity.
          </p>
        </div>

        <div class="features-grid font-sans">
          {features.map((f) => (
            <div class="feature-card">
              <div class="feature-header">
                <div class="feature-icon-badge">
                  {f.iconType === "search" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                  )}
                  {f.iconType === "tools" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                  )}
                  {f.iconType === "calc" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="16" y1="14" x2="16" y2="18"></line></svg>
                  )}
                  {f.iconType === "clipboard" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
                  )}
                  {f.iconType === "window" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                  )}
                  {f.iconType === "terminal" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
                  )}
                </div>
                <span class="feature-num">{f.num}</span>
              </div>

              <h3 class="feature-card-title font-serif">{f.title}</h3>
              <p class="feature-card-desc">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Performance Benchmark Table -->
    <section class="section benchmark-section">
      <div class="container">
        <div class="section-title-wrap">
          <small class="page-meta font-sans">BENCHMARKS</small>
          <h2 class="section-heading font-serif">Resource Usage Comparison</h2>
        </div>

        <div class="table-responsive">
          <table class="benchmark-table font-sans">
            <thead>
              <tr>
                <th>Metric</th>
                <th class="col-highlight">LiteCast</th>
                <th>Raycast / PowerToys</th>
                <th>Electron Launchers</th>
              </tr>
            </thead>
            <tbody>
              {benchmarks.map((b) => (
                <tr>
                  <td class="cell-kriter"><strong>{b.criterion}</strong></td>
                  <td class="cell-highlight">{b.litecast}</td>
                  <td>{b.raycast}</td>
                  <td class="cell-muted">{b.electron}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Shortcuts & Cheatsheet (3 symmetric cards) -->
    <section class="section cheatsheet-section">
      <div class="container">
        <div class="section-title-wrap">
          <small class="page-meta font-sans">QUICK REFERENCE</small>
          <h2 class="section-heading font-serif">Keybindings & Manual</h2>
        </div>

        <div class="cheatsheet-grid font-sans">
          <div class="cheat-card">
            <h3 class="cheat-title font-serif">Keybindings</h3>
            <div class="key-list">
              {shortcuts.map((s) => (
                <div class="key-row">
                  <span class="key-tag"><kbd>{s.key}</kbd></span>
                  <span class="key-desc">{s.desc}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="cheat-card">
            <h3 class="cheat-title font-serif">App Aliases</h3>
            <div class="alias-grid">
              {aliases.map((a) => (
                <div class="alias-item">
                  <span class="alias-code"><code>{a.alias}</code></span>
                  <span class="alias-arrow">➔</span>
                  <span class="alias-name">{a.target}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="cheat-card">
            <h3 class="cheat-title font-serif">Commands</h3>
            <div class="cmd-list">
              {internalCmds.map((c) => (
                <div class="cmd-row">
                  <span class="cmd-tag"><code>{c.cmd}</code></span>
                  <span class="cmd-desc">{c.desc}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Engineering Stack (4 symmetric cards) -->
    <section class="section arch-section">
      <div class="container">
        <div class="section-title-wrap">
          <small class="page-meta font-sans">ARCHITECTURE</small>
          <h2 class="section-heading font-serif">Engineering Stack</h2>
        </div>

        <div class="arch-grid font-sans">
          <div class="arch-box">
            <span class="arch-label">Language</span>
            <strong class="arch-val text-white">Rust 2024</strong>
            <p class="arch-desc">Guaranteed memory safety and zero-cost bare-metal performance.</p>
          </div>
          <div class="arch-box">
            <span class="arch-label">Windows API</span>
            <strong class="arch-val text-white">windows-rs (0.62+)</strong>
            <p class="arch-desc">Direct Microsoft Windows SDK bindings for maximum system call speed.</p>
          </div>
          <div class="arch-box">
            <span class="arch-label">Graphics</span>
            <strong class="arch-val text-white">Win32 GDI & DWM</strong>
            <p class="arch-desc">Hardware-backed Acrylic and Mica transparency without browser lag.</p>
          </div>
          <div class="arch-box">
            <span class="arch-label">Search Algorithm</span>
            <strong class="arch-val text-white">Subsequence Fuzzy</strong>
            <p class="arch-desc">In-memory subsequence indexer that yields results in under 1 millisecond.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Download Section (2 balanced cards) -->
    <section class="section download-section" id="download">
      <div class="container">
        <div class="section-title-wrap text-center">
          <small class="page-meta font-sans">GET STARTED</small>
          <h2 class="section-heading font-serif">Download LiteCast</h2>
          <p class="section-intro font-sans">
            Ready for Windows 10 and 11 (64-bit).
          </p>
        </div>

        <div class="download-grid-two font-sans">
          <!-- Card 1: Setup Option -->
          <div class="download-card download-featured">
            <div class="card-glow-accent"></div>
            <div class="download-badge">RECOMMENDED</div>
            
            <div class="card-top-content">
              <div class="download-icon-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              </div>
              <h3 class="download-title font-serif">Automated Setup</h3>
              <p class="download-desc">Installer with automatic system tray integration, shortcut creation, and auto-start option.</p>
            </div>

            <div class="card-bottom-content">
              <div class="download-file-info">
                <span>LiteCast-Setup.exe</span>
                <span>~1.7 MB (v1.0.0)</span>
              </div>
              <a href="/downloads/litecast/LiteCast-Setup.exe" class="btn-delicate btn-delicate-primary btn-full" download>
