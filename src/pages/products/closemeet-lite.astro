<script is:inline>
  (() => {
    function initCloseMeetSim() {
      const grid = document.getElementById("cmMeshGrid");
      const logBar = document.getElementById("cmSimLog");
      if (!grid || !logBar) return;

      const peerRoster = [
        { id: "P1", name: "Harun_Host (You)", role: "HOST", codec: "NVENC H.264" },
        { id: "P2", name: "Emre_Dev", role: "PEER", codec: "NVENC H.264" },
        { id: "P3", name: "Selin_SecOps", role: "PEER", codec: "Intel QSV" },
        { id: "P4", name: "Kaan_NetEng", role: "PEER", codec: "AMD AMF" },
        { id: "P5", name: "Deniz_QA", role: "PEER", codec: "NVENC H.264" },
        { id: "P6", name: "Mert_Arch", role: "PEER", codec: "Intel QSV" }
      ];

      const tierProfiles = {
        "720p": { label: "1280×720 @ 30 FPS", bwFactor: 1.0, rtt: "18 ms / 2.1 ms" },
        "480p": { label: "854×480 @ 24 FPS", bwFactor: 0.55, rtt: "195 ms / 9.4 ms" },
        "360p": { label: "640×360 @ 15 FPS", bwFactor: 0.28, rtt: "320 ms / 18.0 ms" },
        "audio": { label: "Opus Audio-Only (64 kbps)", bwFactor: 0.05, rtt: "410 ms / 26.5 ms" }
      };

      const peerBudgets = {
        2: { links: 1, streams: 2, cpu: "4.2%", ram: "85 MB", baseBw: 1.5 },
        4: { links: 6, streams: 12, cpu: "8.4%", ram: "138 MB", baseBw: 3.2 },
        6: { links: 15, streams: 30, cpu: "13.8%", ram: "212 MB", baseBw: 4.5 }
      };

      let state = {
        peers: 4,
        tier: "720p",
        speakerIdx: 0,
        relay: false,
        lan: false,
        rec: false,
        frames: 14820,
        dropped: 0
      };

      function setLog(msg, statusRight = "FAIL-CLOSED: ARMED") {
        logBar.innerHTML = `<span>${msg}</span><span class="code">${statusRight}</span>`;
      }

      function renderSim() {
        const activePeers = peerRoster.slice(0, state.peers);
        const budget = peerBudgets[state.peers] || peerBudgets[4];
        const tier = tierProfiles[state.tier] || tierProfiles["720p"];

        grid.innerHTML = activePeers.map((p, idx) => {
          const isSpeaking = idx === (state.speakerIdx % activePeers.length);
          const streamLabel = state.tier === "audio" ? "OPUS 48kHz (VAD)" : `${state.tier.toUpperCase()} // ${p.codec}`;
          return `
            <div class="cm-peer-tile ${isSpeaking ? "speaking" : ""}">
              <div class="cm-peer-head">
                <span>${p.id} // ${p.role}</span>
                <span style="color: ${isSpeaking ? "var(--green)" : "var(--muted)"};">${isSpeaking ? "● VAD SPEAKING" : "🔒 GCM OK"}</span>
              </div>
              <div class="cm-peer-avatar">${p.id}</div>
              <div class="cm-peer-foot">
                <b>${p.name}</b>
                <span>${streamLabel}</span>
              </div>
            </div>
          `;
        }).join("");

        const peerBadge = document.getElementById("cmPeerCountBadge");
        if (peerBadge) peerBadge.textContent = `👥 ${state.peers} / 6 PEERS`;

        const transportBadge = document.getElementById("cmTransportBadge");
        if (transportBadge) {
          if (state.lan) {
            transportBadge.textContent = "📡 OFFLINE LAN (mDNS _closemeet._tcp.local)";
            transportBadge.className = "cm-sim-badge secure";
          } else if (state.relay) {
            transportBadge.textContent = "🛡 TURN PRIVACY RELAY (IP MASKED)";
            transportBadge.className = "cm-sim-badge relay";
          } else {
            transportBadge.textContent = "⚡ DIRECT P2P (0 INBOUND PORTS)";
            transportBadge.className = "cm-sim-badge";
          }
        }

        const recBadge = document.getElementById("cmRecBadge");
        if (recBadge) {
          recBadge.style.display = state.rec ? "inline-flex" : "none";
        }

        const bwVal = (budget.baseBw * tier.bwFactor).toFixed(2);
        const hudLinks = document.getElementById("hudLinks");
        const hudProfile = document.getElementById("hudProfile");
        const hudCpu = document.getElementById("hudCpu");
        const hudRam = document.getElementById("hudRam");
        const hudBw = document.getElementById("hudBw");
        const hudRtt = document.getElementById("hudRtt");
        const hudFrames = document.getElementById("hudFrames");
        const hudDropped = document.getElementById("hudDropped");

        if (hudLinks) hudLinks.textContent = `${budget.links} Bidirectional (${budget.streams} Streams)`;
        if (hudProfile) hudProfile.textContent = tier.label;
        if (hudCpu) hudCpu.textContent = `${budget.cpu} (<15% target)`;
        if (hudRam) hudRam.textContent = `${budget.ram} (<250 MB cap)`;
        if (hudBw) hudBw.textContent = `${bwVal} Mbps / ${bwVal} Mbps`;
        if (hudRtt) hudRtt.textContent = state.lan ? "1.2 ms / 0.3 ms (LAN)" : tier.rtt;
        if (hudFrames) hudFrames.textContent = `${state.frames.toLocaleString()} (96-bit IV)`;
        if (hudDropped) hudDropped.textContent = `${state.dropped} (Fail-Closed)`;
      }

      document.querySelectorAll("[data-peers]").forEach(btn => {
        btn.addEventListener("click", () => {
          document.querySelectorAll("[data-peers]").forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          state.peers = Number(btn.getAttribute("data-peers"));
          state.frames += 120;
          const links = (state.peers * (state.peers - 1)) / 2;
          setLog(`[MESH] Topology reconfigured to ${state.peers} peers (${links} bidirectional P2P links, 0 central SFU).`);
          window.hek75Sound?.beep?.(520, 0.035, "square", 0.012);
          renderSim();
        });
      });

      document.querySelectorAll("[data-tier]").forEach(btn => {
        btn.addEventListener("click", () => {
          document.querySelectorAll("[data-tier]").forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          state.tier = btn.getAttribute("data-tier") || "720p";
          setLog(`[ABR ENGINE] Hysteresis filter switched stream tier to ${tierProfiles[state.tier].label}. Opus 48kHz audio guaranteed.`);
          window.hek75Sound?.beep?.(460, 0.035, "square", 0.012);
          renderSim();
        });
      });

      const btn7th = document.getElementById("cmBtn7thPeer");
      if (btn7th) {
        btn7th.addEventListener("click", () => {
          setLog(`[SECURITY GUARD] 7th peer connection request atomically rejected with ROOM_FULL (Close Code 4001) to protect O(N²) mesh budget.`, "ROOM_FULL: BLOCKED");
          window.hek75Sound?.beep?.(240, 0.06, "sawtooth", 0.016);
        });
      }

      const btnSpeaker = document.getElementById("cmBtnSpeaker");
      if (btnSpeaker) {
        btnSpeaker.addEventListener("click", () => {
          state.speakerIdx = (state.speakerIdx + 1) % state.peers;
          state.frames += 45;
          const activePeer = peerRoster[state.speakerIdx];
          setLog(`[VAD TRACKER] PCM RMS + Hysteresis switched active speaker highlight to ${activePeer.name}.`);
          window.hek75Sound?.beep?.(610, 0.03, "triangle", 0.012);
          renderSim();
        });
      }

      const btnRelay = document.getElementById("cmBtnRelay");
      if (btnRelay) {
        btnRelay.addEventListener("click", () => {
          state.relay = !state.relay;
          if (state.relay) state.lan = false;
          btnRelay.classList.toggle("active", state.relay);
          const btnLan = document.getElementById("cmBtnLan");
          if (btnLan && state.relay) btnLan.classList.remove("active");
          btnRelay.textContent = `🛡 PRIVACY RELAY (TURN): ${state.relay ? "ON" : "OFF"}`;
          if (btnLan) btnLan.textContent = `📡 OFFLINE LAN (mDNS): ${state.lan ? "ON" : "OFF"}`;
          setLog(state.relay
            ? `[PRIVACY RELAY] Host/STUN ICE candidates disabled. All P2P streams routed strictly over TURN relay to prevent peer IP disclosure.`
            : `[ICE TRANSPORT] Restored direct P2P STUN hole-punching with 0 inbound listening ports.`);
          window.hek75Sound?.beep?.(540, 0.035, "square", 0.012);
          renderSim();
        });
      }

      const btnLan = document.getElementById("cmBtnLan");
      if (btnLan) {
        btnLan.addEventListener("click", () => {
          state.lan = !state.lan;
          if (state.lan) state.relay = false;
          btnLan.classList.toggle("active", state.lan);
          const btnRelayEl = document.getElementById("cmBtnRelay");
          if (btnRelayEl && state.lan) {
            btnRelayEl.classList.remove("active");
            btnRelayEl.textContent = "🛡 PRIVACY RELAY (TURN): OFF";
          }
          btnLan.textContent = `📡 OFFLINE LAN (mDNS): ${state.lan ? "ON" : "OFF"}`;
          setLog(state.lan
            ? `[OFFLINE LAN] Discovered local room via mDNS (_closemeet._tcp.local). Host-as-Bridge signaling active with zero external internet.`
            : `[WAN SIGNALING] Switched back to standard WebSocket signaling bridge.`);
          window.hek75Sound?.beep?.(580, 0.035, "square", 0.012);
          renderSim();
        });
      }

      const btnRec = document.getElementById("cmBtnRec");
      if (btnRec) {
        btnRec.addEventListener("click", () => {
          state.rec = !state.rec;
          btnRec.classList.toggle("active", state.rec);
          btnRec.textContent = `● LOCAL MP4 REC: ${state.rec ? "ON" : "OFF"}`;
          setLog(state.rec
            ? `[SESSION RECORDER] Recording 1280×720 H.264/AAC MP4 (ftyp/moov/mdat) locally to %USERPROFILE%\\Videos\\CloseMeet\\Recordings.`
            : `[SESSION RECORDER] Finalized MP4 moov atom and saved recording to local disk. Zero cloud upload.`);
          window.hek75Sound?.beep?.(500, 0.035, "square", 0.012);
          renderSim();
        });
      }

      const btnTamper = document.getElementById("cmBtnTamper");
      if (btnTamper) {
        btnTamper.addEventListener("click", () => {
          state.dropped += 1;
          setLog(`[CNG BCRYPT GUARD] Bit-flip detected in 16-byte AES-256-GCM Auth Tag! Frame silently discarded (corrupted_frames_dropped_ = ${state.dropped}). Zero bytes leaked to UI.`, "AUTH TAG TAMPER: DROPPED");
          window.hek75Sound?.beep?.(310, 0.055, "sawtooth", 0.016);
          renderSim();
        });
      }

      renderSim();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initCloseMeetSim);
    } else {
      initCloseMeetSim();
    }
    document.addEventListener("astro:page-load", initCloseMeetSim);
  })();
</script>
