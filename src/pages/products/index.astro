---
// src/pages/products/index.astro
// HEK75 ARCADE OS — Software Products Catalog.

import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Software Products & Tools // HEK75 OS — Harun Emrecan Karabağ"
  description="Native desktop software and developer tools developed by Harun Emrecan Karabağ (HEK75), including LiteCast ultra-low latency screen mirroring."
  activeNav="products"
  footerLeft="TERMINAL COMMAND: litecast"
  footerRight="HEK75 OS // PRODUCTS.DB"
>
  <div class="section-head">
    <div>
      <div class="code">SOFTWARE DATABASE // NATIVE TOOLS</div>
      <h1>PRODUCTS</h1>
    </div>
    <span class="meta">BUILD SMALL // RUN FAST</span>
  </div>

  <section class="product-card">
    <div class="product-head">
      <div class="product-icon">
        <img
          src="/assets/litecast/icon.png"
          alt="LiteCast icon"
          onerror="this.style.display='none';this.parentElement.innerHTML='<div class=&quot;product-icon-fallback&quot;>LC</div>'"
        />
      </div>
      <div>
        <div class="meta">ACTIVE // v1.0.0 // WINDOWS 10 / 11 x64</div>
        <h2>LITECAST</h2>
        <div class="blue">Ultra-lightweight native Windows launcher & developer toolkit</div>
      </div>
    </div>

    <p>
      A keyboard-first launcher built around Rust and native Windows APIs.
      It combines app/file search, developer utilities, clipboard workflows,
      window switching and command actions without carrying a browser runtime.
    </p>

    <div class="spec-row">
      <span class="spec"><b>LANG:</b> Rust 2024</span>
      <span class="spec"><b>RAM:</b> ~25–40 MB</span>
      <span class="spec"><b>TRIGGER:</b> &lt;50ms target</span>
      <span class="spec"><b>STACK:</b> Win32 / DWM</span>
      <span class="spec"><b>WEB RUNTIME:</b> 0%</span>
    </div>

    <div class="tags">
      <span class="tag">Fuzzy Search</span>
      <span class="tag">DevTools</span>
      <span class="tag">Clipboard</span>
      <span class="tag">Window Switcher</span>
      <span class="tag">Offline-first</span>
    </div>

    <div class="product-actions">
      <a class="btn" href="/products/litecast/">EXPLORE LITECAST →</a>
      <a class="btn yellow" href="/downloads/litecast/LiteCast-Setup.exe" download>DOWNLOAD SETUP ↗</a>
      <a class="btn blue" href="https://github.com/Hekyetmisbes/litecast" target="_blank" rel="noopener">GITHUB ↗</a>
    </div>
  </section>

  <div class="section-head" style="margin-top: 34px;">
    <div>
      <div class="code">R&D QUEUE</div>
      <h2>IN DEVELOPMENT</h2>
    </div>
  </div>

  <section class="upcoming-card">
    <div class="meta">GAME TOOLING // IN RESEARCH</div>
    <h3>GameDev Asset Pipeline Optimizer</h3>
    <p>
      Experimental Rust CLI/GUI tooling for asset compression and format conversion workflows targeting Unity and Unreal Engine pipelines.
    </p>
  </section>
</Layout>
