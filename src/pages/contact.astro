---
// src/pages/contact.astro
// HEK75 ARCADE OS — Transmission Station / Contact.

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Harun Emrecan Karabağ | Game Developer"
  description="Get in touch with game developer and software engineer Harun Emrecan Karabağ for Unity, Unreal Engine, gameplay programming, and collaborations."
  activeNav="contact"
  footerLeft="STATUS: CHANNELS OPEN // TRANSMIT AT WILL"
  footerRight="HEK75 OS // MULTIPLAYER.SYS"
  breadcrumbs={[
    { name: "HOME", url: "/" },
    { name: "CONTACT", url: "/contact/" }
  ]}
>
  <nav class="breadcrumb" aria-label="Breadcrumbs" itemscope itemtype="https://schema.org/BreadcrumbList">
    <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="/" itemprop="item"><span itemprop="name">HOME</span></a>
      <meta itemprop="position" content="1" />
    </span>
    <span class="breadcrumb-separator">/</span>
    <span itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <span class="breadcrumb-current" itemprop="name">CONTACT</span>
      <link itemprop="item" href="https://hek75.com/contact/" />
      <meta itemprop="position" content="2" />
    </span>
  </nav>

  <div class="section-head">
    <div>
      <div class="code">MULTIPLAYER // DIRECT CHANNELS</div>
      <h1>Contact Harun Emrecan Karabağ</h1>
    </div>
    <span class="meta">COMMS.STATION</span>
  </div>

  <p class="muted" style="max-width: 760px; line-height: 1.7; margin-bottom: 28px;">
    Open for game development collaborations, technical discussions, gameplay prototyping, and engineering inquiries.
    Select a frequency below to establish communication.
  </p>

  <div class="content-grid">
    <div class="panel">
      <h3>[ PRIMARY EMAIL ]</h3>
      <p style="margin-bottom: 16px;">Direct inbox for project proposals and formal inquiries.</p>
      <a class="btn yellow" href="mailto:harunemrecankarabag@gmail.com">
        SEND EMAIL ↗
      </a>
      <div class="code" style="margin-top: 12px; font-size: 10px;">harunemrecankarabag@gmail.com</div>
    </div>

    <div class="panel">
      <h3>[ LINKEDIN NETWORK ]</h3>
      <p style="margin-bottom: 16px;">Professional updates, network messaging and development logs.</p>
      <a class="btn blue" href="https://www.linkedin.com/in/harunemrecankarabag/" target="_blank" rel="noopener">
        OPEN LINKEDIN ↗
      </a>
      <div class="code" style="margin-top: 12px; font-size: 10px;">in/harunemrecankarabag</div>
    </div>

    <div class="panel">
      <h3>[ GITHUB REPOSITORIES ]</h3>
      <p style="margin-bottom: 16px;">Open source projects, experimental engines, tools and prototypes.</p>
      <a class="btn" href="https://github.com/Hekyetmisbes" target="_blank" rel="noopener">
        VIEW REPOSITORIES ↗
      </a>
      <div class="code" style="margin-top: 12px; font-size: 10px;">github.com/Hekyetmisbes</div>
    </div>

    <div class="panel">
      <h3>[ INSTAGRAM ]</h3>
      <p style="margin-bottom: 16px;">Visual snippets, creative experiments and dev snapshots.</p>
      <a class="btn" href="https://www.instagram.com/hekyetmisbes/" target="_blank" rel="noopener">
        VISIT INSTAGRAM ↗
      </a>
      <div class="code" style="margin-top: 12px; font-size: 10px;">@hekyetmisbes</div>
    </div>
  </div>

  <div style="margin-top: 36px;">
    <a class="btn" href="/">← RETURN TO MAIN HUB</a>
  </div>
</Layout>
