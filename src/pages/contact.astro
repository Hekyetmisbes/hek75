---
// src/pages/contact.astro
// Clean Contact Page without right-side CTA text labels.

import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Harun Emrecan Karabağ" description="Harun Emrecan Karabağ - Contact details and social media links.">
  <section class="contact-viewport-section">
    <div class="container contact-container">
      <small class="page-meta font-sans">CONTACT · END GAME</small>
      <h1 class="section-title font-serif">Get in Touch</h1>
      <p class="contact-subtitle font-sans">
        Feel free to reach out for game development opportunities, project collaborations, or game design discussions.
      </p>

      <div class="contact-methods-grid">
        <a href="mailto:harunemrecankarabag@gmail.com" class="contact-method-card">
          <div class="icon-circle">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </div>
          <div class="method-info">
            <h2 class="method-title font-serif">Send Email</h2>
            <p class="method-val text-blue font-sans">harunemrecankarabag@gmail.com</p>
          </div>
        </a>

        <a href="https://www.linkedin.com/in/harunemrecankarabag/" target="_blank" rel="noopener noreferrer" class="contact-method-card">
          <div class="icon-circle">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </div>
          <div class="method-info">
            <h2 class="method-title font-serif">Connect on LinkedIn</h2>
            <p class="method-val text-blue font-sans">harunemrecankarabag</p>
          </div>
        </a>

        <a href="https://github.com/Hekyetmisbes" target="_blank" rel="noopener noreferrer" class="contact-method-card">
          <div class="icon-circle">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
          </div>
          <div class="method-info">
            <h2 class="method-title font-serif">GitHub Repositories</h2>
            <p class="method-val text-blue font-sans">Hekyetmisbes</p>
          </div>
        </a>

        <a href="https://www.instagram.com/hekyetmisbes/" target="_blank" rel="noopener noreferrer" class="contact-method-card">
          <div class="icon-circle">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </div>
          <div class="method-info">
            <h2 class="method-title font-serif">Instagram</h2>
            <p class="method-val text-blue font-sans">hekyetmisbes</p>
          </div>
        </a>
      </div>

      <p class="contact-page-copyright font-sans">© 2026 HARUN EMRECAN KARABAĞ. ANKARA, TURKEY.</p>
    </div>
  </section>
</Layout>

<style>
  .contact-viewport-section {
    height: 100vh;
    min-height: 580px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 80px;
    padding-bottom: 20px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .contact-container {
    max-width: 1140px;
    width: 100%;
    text-align: center;
  }

  .page-meta {
    letter-spacing: 0.2em;
    font-size: 0.75rem;
    color: var(--pastel-blue);
    font-weight: 600;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.25rem;
  }

  .contact-viewport-section .section-title {
    margin-bottom: 0.5rem;
  }

  .contact-subtitle {
    font-size: 1.0625rem;
    color: var(--muted);
    max-width: 680px;
    margin: 0 auto 2.5rem;
    line-height: 1.5;
  }

  .contact-methods-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    margin-bottom: 2.5rem;
  }

  .contact-method-card {
    background: #07090e;
    border: 1px solid rgba(255, 255, 255, 0.18);
    padding: 1.75rem 2rem;
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    text-decoration: none;
    color: var(--white);
    text-align: left;
    transition: border-color 0.25s ease, transform 0.25s ease, background-color 0.25s ease;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
    cursor: pointer;
  }

  .contact-method-card:hover {
    border-color: #ffffff;
    background: #0b0f19;
    transform: translateY(-3px);
  }

  .icon-circle {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pastel-blue);
    flex-shrink: 0;
    transition: border-color 0.25s ease, color 0.25s ease;
  }

  .contact-method-card:hover .icon-circle {
    border-color: #ffffff;
    color: #ffffff;
  }

  .method-info {
    flex-grow: 1;
  }

  .method-title {
    font-size: 1.35rem;
    margin-bottom: 0.2rem;
    color: var(--white);
    line-height: 1.15;
  }

  .method-val {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .contact-page-copyright {
    font-size: 0.75rem;
    color: var(--muted-dark);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .contact-methods-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .contact-viewport-section {
      height: auto;
      min-height: 100vh;
      padding-top: 110px;
      padding-bottom: 40px;
    }
  }
</style>
