---
// src/pages/about.astro
// English Cinematic Director & Game Developer Biography Page (Stats section removed).

import Layout from '../layouts/Layout.astro';
---

<Layout title="About Me | Harun Emrecan Karabağ" description="Harun Emrecan Karabağ - Biography and projects.">
  <section class="section border-none about-page-section">
    <div class="container">
      <small class="page-meta font-sans">ABOUT · BIOGRAPHY</small>
      <h1 class="section-title font-serif">About Me</h1>
      
      <div class="about-grid">
        <div class="about-text-col">
          <div class="scene-tag font-sans">SCENE 01 / BIOGRAPHY & VISION</div>
          <p class="about-paragraph text-highlight font-serif">
            "A game is a cinematic journey that begins in the player's mind and continues long after the screen goes dark."
          </p>
          <p class="about-paragraph font-serif">
            Hello! I am Harun Emrecan Karabağ. I combine my computer engineering principles with my passion for game development, designing atmospheric games that feature strong technical optimization and deep narrative resonance.
          </p>
          <p class="about-paragraph font-serif">
            I focus on core game mechanics, level design, spatial audio design, and artificial intelligence systems across Unity (URP) and Unreal Engine 5. I value the emotional mood, pacing, and feeling of a scene just as much as code stability.
          </p>
          
          <div class="about-cv-action">
            <a href="/assets/Resume.pdf" target="_blank" class="btn btn-primary font-sans">
              Download Resume File ↗
            </a>
          </div>
        </div>
        
        <div class="about-img-col">
          <div class="about-image-card">
            <div class="film-clapper-header">
              <span class="clapper-text font-sans">PROD: HEK75 PORTFOLIO</span>
              <span class="clapper-text font-sans">TAKE: 2026</span>
            </div>
            <div class="about-image-wrapper">
              <img src="/assets/Emre.png" alt="Harun Emrecan Karabağ" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-page-section {
    padding-top: 130px;
    padding-bottom: 90px;
  }

  .page-meta {
    letter-spacing: 0.18em;
    font-size: 0.75rem;
    color: var(--pastel-blue);
    font-weight: 600;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.35rem;
  }

  .scene-tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--pastel-blue);
    margin-bottom: 1.25rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .about-paragraph {
    font-size: 1.125rem;
    color: var(--muted);
    margin-bottom: 1.4rem;
    line-height: 1.8;
  }

  .text-highlight {
    color: var(--white);
    font-size: 1.4rem;
    line-height: 1.45;
    margin-bottom: 1.6rem;
  }

  .about-cv-action {
    margin-top: 2rem;
  }

  .about-img-col {
    display: flex;
    justify-content: center;
  }

  .about-image-card {
    background: #07090e;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    padding: 1rem;
    max-width: 340px;
    width: 100%;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
  }

  .film-clapper-header {
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
    font-size: 0.6875rem;
    color: var(--muted);
    letter-spacing: 0.1em;
  }

  .about-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 6px;
    overflow: hidden;
    background: #000;
  }

  .about-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .about-image-card:hover img {
    transform: scale(1.04);
  }

  @media (max-width: 800px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .about-img-col {
      order: -1;
    }
  }
</style>
