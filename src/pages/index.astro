    <!-- Client-Side Navigation and Filtering Logic in TypeScript -->
    <script>
      // 1. Navigation Active State on Scroll
      const sections = document.querySelectorAll('section[id]');
      const navLinks = document.querySelectorAll('.hud-link');

      window.addEventListener('scroll', () => {
        let current: string | null = '';
        const scrollY = window.pageYOffset;
        
        sections.forEach((section) => {
          const sectionHeight = (section as HTMLElement).offsetHeight;
          const sectionTop = (section as HTMLElement).offsetTop - 120;
          const sectionId = section.getAttribute('id');
          
          if (scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {
            current = sectionId;
          }
        });

        navLinks.forEach((link) => {
          link.classList.remove('active');
          if (link.getAttribute('data-sec') === current) {
            link.classList.add('active');
          }
        });
      });

      // 2. Project Filtering
      const tabs = document.querySelectorAll('.filter-tab');
      const cards = document.querySelectorAll('.project-card');

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          // Remove active class from all tabs
          tabs.forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');

          const filter = tab.getAttribute('data-filter');

          cards.forEach((card) => {
            const cardEl = card as HTMLElement;
            const category = cardEl.getAttribute('data-category');

            if (filter === 'all' || filter === category) {
              cardEl.style.display = 'flex';
              // Trigger a small animation
              cardEl.style.opacity = '0';
              setTimeout(() => {
                cardEl.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                cardEl.style.opacity = '1';
              }, 50);
            } else {
              cardEl.style.display = 'none';
            }
          });
        });
      });

      // 3. Card click handler (opening URLs)
      cards.forEach((card) => {
        card.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          // If clicked the direct anchor link icon, let the browser handle it
          if (target.closest('a')) return;
          
          const link = card.querySelector('.project-card-footer a');
          if (link) {
            const url = link.getAttribute('href');
            if (url) {
              window.open(url, '_blank', 'noopener,noreferrer');
            }
          }
        });
      });
    </script>
