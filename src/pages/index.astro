---
// Hek75 Portfolio - Main Page in Astro + TypeScript
// Designed to match the premium purple neon-accented glassmorphism style.
// Fast, lightweight, zero-JS by default, except for the client-side project filtering.

const title = "Harun Emrecan Karabağ | Game Developer Portfolio";
const description = "Harun Emrecan Karabağ - Computer Engineer and Game Developer portfolio website.";

const projects = [
  {
    title: "The Final Loop",
    genre: "Psychological Puzzle / Vertical Slice",
    engine: "Unreal Engine",
    desc: "Unreal Engine ile geliştirilmiş psikolojik bulmaca oyunu. Karanlık bir araştırma tesisinde hafıza döngülerini keşfedin ve odalardan kaçış bulmacalarını çözün.",
    link: "/projects/thefinalloop/",
    category: "oyunlar",
    year: "2026",
    image: "/assets/echoes.png"
  },
  {
    title: "The Unlit Door",
    genre: "Psychological Puzzle / Pitch",
    engine: "Unity",
    desc: "Psikolojik ve anlatı odaklı bir bulmaca oyunu projesi için hazırlanan, konsept ve atmosfer detaylarını içeren yazılı pitch sayfası.",
    link: "/projects/theunlitdoor/",
    category: "diger",
    year: "2025",
    image: "/assets/luma.png"
  },
  {
    title: "Delivery Driver",
    genre: "3D Simulation",
    engine: "Unity",
    desc: "Şehir içinde siparişleri zamanında teslim etmeye çalıştığınız eğlenceli bir Unity 3D simülasyon ve sürüş oyunu.",
    link: "https://hekyetmisbes.itch.io/delivery-driver",
    category: "oyunlar",
    year: "2024",
    image: "/assets/tiny_survivor.png"
  },
  {
    title: "Fog Bridge",
    genre: "Atmospheric Narrative Puzzle",
    engine: "Unity",
    desc: "GameDev.tv Game Jam 2026 için geliştirilen, sisler arasından gelen kağıt uçaklardaki mesajları çözerek köprüyü yeniden kurduğunuz atmosferik bulmaca oyunu.",
    link: "https://hekyetmisbes.itch.io/fog-bridge",
    category: "jam",
    year: "2026",
    image: "/assets/hero_background.png"
  },
  {
    title: "Movidle Game",
    genre: "Web Game / Puzzle",
    engine: "Unity",
    desc: "IMDb Top 250 listesindeki filmleri tahmin etmeye çalıştığınız, renk kodlu ipuçları sunan eğlenceli bir Unity web bulmaca oyunu.",
    link: "https://github.com/Hekyetmisbes/movidle",
    category: "oyunlar",
    year: "2025",
    image: "/assets/orbital.png"
  },
  {
    title: "Flag Quiz Game",
    genre: "Mobile Quiz / Educational",
    engine: "Unity",
    desc: "Oyuncuların coğrafya bilgisini geliştirmesini hedefleyen, Unity ve C# ile mobil cihazlar için optimize edilmiş bayrak tahmin oyunu.",
    link: "https://github.com/Hekyetmisbes/flag-quiz-game",
    category: "oyunlar",
    year: "2023",
    image: "/assets/luma.png"
  }
];

const experiences = [
  {
    role: "Kurucu Ortak (Co-Founder)",
    company: "Fiction Technology Studios",
    location: "Ankara, Türkiye",
    date: "Aralık 2025 - Nisan 2026",
    desc: "Bağımsız oyun ve yazılım stüdyosu kurucu ortaklığı. Ürün planlama, görev takibi ve teslim süreçlerinin yönetimi. Kotlin tabanlı mobil uygulamalar geliştirilmesi ve ürün yol haritalarının yönetilmesi.",
    tech: ["Proje Yönetimi", "Kotlin", "React"]
  },
  {
    role: "Stajyer Yazılım Mühendisi",
    company: "Erciyes Üniversitesi Bilgi İşlem Daire Bşk.",
    location: "Kayseri",
    date: "Temmuz 2025 - Ağustos 2025",
    desc: "ASP.NET Core 8 ve Temiz Mimari (Clean Architecture) kullanılarak Personel Rehberi sisteminin geliştirilmesi. Elasticsearch entegrasyonu ve rol tabanlı admin paneli tasarımı.",
    tech: ["ASP.NET Core", "Elasticsearch", "CQRS", "Docker"]
  },
  {
    role: "Donanım Mühendisliği Stajyeri",
    company: "Fotonik Teknoloji A.Ş.",
    location: "Ankara",
    date: "Temmuz 2024 - Ağustos 2024",
    desc: "Donanım bileşenlerinin tasarımı ve iyileştirilmesi. Performans testlerinin yapılması ve teknik dokümantasyon süreçlerinin yürütülmesi.",
    tech: ["Donanım Tasarımı", "Test", "Dokümantasyon"]
  }
];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/assets/spider-favicon.svg" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Navbar / HUD Header -->
    <header class="hud-header" id="navbar">
      <div class="container hud-nav">
        <div class="hud-logo">
          <a href="#hero">
            <span class="text-white font-black">H</span><span class="text-purple">K</span>
          </a>
        </div>
        <nav class="hud-menu" aria-label="Ana Menü">
          <a href="#projeler" class="hud-link active" data-sec="projeler">Projeler</a>
          <a href="#hakkimda" class="hud-link" data-sec="hakkimda">Hakkımda</a>
          <a href="#yetkinlikler" class="hud-link" data-sec="yetkinlikler">Yetkinlikler</a>
          <a href="#iletisim" class="hud-link" data-sec="iletisim">İletişim</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero Section -->
      <section id="hero" class="hero-section">
        <div class="hero-bg-overlay"></div>
        <div class="container hero-content">
          <p class="hero-greeting text-purple">Merhaba, ben</p>
          <h1 class="hero-title">Harun Emrecan <br class="mobile-only"/><span class="text-purple glow-text">Karabağ</span></h1>
          <p class="hero-subtitle text-purple-light">Game Developer</p>
          <p class="hero-desc">
            Oyun geliştirmeye tutkulu bir geliştirici. Etkileyici dünyalar ve unutulmaz deneyimler oluşturuyorum.
          </p>
          <div class="hero-actions">
            <a href="#projeler" class="btn btn-primary">Projelerimi Gör <span class="arrow-icon">→</span></a>
          </div>
          
          <!-- Social Links -->
          <div class="hero-socials">
            <a href="https://github.com/Hekyetmisbes" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            </a>
            <a href="https://www.linkedin.com/in/harunemrecankarabag/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            </a>
            <a href="mailto:harunemrecankarabag@gmail.com" aria-label="E-posta">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </a>
          </div>
        </div>

        <div class="scroll-down-arrow">
          <a href="#projeler" aria-label="Aşağı Kaydır">
            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
          </a>
        </div>
      </section>

      <!-- Projelerim Section -->
      <section id="projeler" class="section">
        <div class="container">
          <div class="section-header">
            <h2 class="section-title">Projelerim</h2>
            <div class="filter-tabs">
              <button class="filter-tab active" data-filter="all">Tümü</button>
              <button class="filter-tab" data-filter="oyunlar">Oyunlar</button>
              <button class="filter-tab" data-filter="jam">Oyun Jam</button>
              <button class="filter-tab" data-filter="diger">Diğer</button>
            </div>
          </div>

          <div class="projects-grid">
            {projects.map((project) => (
              <article class="project-card" data-category={project.category}>
                <div class="project-img-wrapper">
                  <img src={project.image} alt={project.title} loading="lazy" />
                  <div class="project-overlay">
                    <span class="btn-detail">Projeyi İncele ↗</span>
                  </div>
                </div>
                <div class="project-info">
                  <div class="project-meta">
                    <span class="project-genre">{project.genre}</span>
                    <span class="project-year">{project.year}</span>
                  </div>
                  <h3 class="project-card-title">{project.title}</h3>
                  <p class="project-desc">{project.desc}</p>
                  <div class="project-card-footer">
                    <span class="project-engine">{project.engine}</span>
                    <a href={project.link} target="_blank" rel="noopener noreferrer" class="project-link-icon" aria-label={`${project.title} sayfasını aç`}>
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Hakkımda Section -->
      <section id="hakkimda" class="section">
        <div class="container">
          <h2 class="section-title text-left">Hakkımda</h2>
          
          <div class="about-grid">
            <div class="about-text-col">
              <p class="about-paragraph">
                Merhaba! Ben Harun Emrecan Karabağ. Oyun geliştirmeye olan ilgim, küçük yaşlarda başladı ve zamanla tutkum haline geldi.
              </p>
              <p class="about-paragraph">
                Unity ve Unreal Engine ile 3D ve 2D oyunlar geliştiriyorum. Oyun mekanikleri, seviye tasarımı (level design) ve oyuncu deneyimi (player experience) üzerine odaklanıyorum.
              </p>
              <p class="about-paragraph">
                Yeni teknolojiler ve yazılım mimarileri öğrenmeyi, yaratıcı projeler üreterek oyun dünyasında kalıcı izler bırakmayı hedefliyorum.
              </p>
              <div class="about-cv-action">
                <a href="/assets/Harun-Emrecan-Karabag-CV.pdf" target="_blank" class="btn btn-outline">
                  Özgeçmişim <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-icon"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                </a>
              </div>
            </div>
            
            <div class="about-img-col">
              <div class="about-image-wrapper">
                <img src="/assets/about_profile.png" alt="Harun Emrecan Karabağ" loading="lazy" />
              </div>
            </div>
          </div>

          <!-- Character Stats (Counters) -->
          <div class="stats-row">
            <div class="stat-box">
              <span class="stat-number">3+</span>
              <span class="stat-label">Yıl Deneyim</span>
            </div>
            <div class="stat-box">
              <span class="stat-number">6+</span>
              <span class="stat-label">Tamamlanan Proje</span>
            </div>
            <div class="stat-box">
              <span class="stat-number">2+</span>
              <span class="stat-label">Oyun Jam</span>
            </div>
            <div class="stat-box">
              <span class="stat-number">∞</span>
              <span class="stat-label">Kahve</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Yetkinlikler Section -->
      <section id="yetkinlikler" class="section">
        <div class="container">
          <h2 class="section-title text-left">Yetkinliklerim</h2>
          <p class="section-subtitle">Kullandığım araçlar ve teknolojiler.</p>

          <div class="skills-categories">
            <!-- Oyun Geliştirme -->
            <div class="skills-category-block">
              <h3 class="category-title">Oyun Geliştirme</h3>
              <div class="skills-grid">
                <div class="skill-item">
                  <div class="skill-icon-wrapper">
                    <!-- Unity Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple"><path d="m2 8 10-6 10 6v8l-10 6L2 16V8z"></path><path d="m12 2 10 6-10 6-10-6z"></path><path d="M12 14v8"></path></svg>
                  </div>
                  <span class="skill-name">Unity</span>
                </div>
                <div class="skill-item">
                  <div class="skill-icon-wrapper">
                    <!-- Unreal C++ Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple"><path d="m12 3-1.912 5.886a1 1 0 0 1-.951.691H2.93a1 1 0 0 0-.588 1.81l5.018 3.645a1 1 0 0 1 .363 1.117L5.81 22.035a1 1 0 0 0 1.54 1.118l5.018-3.646a1 1 0 0 1 1.176 0l5.018 3.646a1 1 0 0 0 1.54-1.118l-1.912-5.886a1 1 0 0 1 .363-1.117l5.018-3.646a1 1 0 0 0-.588-1.81h-6.208a1 1 0 0 1-.951-.69L12 3Z"></path></svg>
                  </div>
                  <span class="skill-name">Unreal Engine</span>
                </div>
                <div class="skill-item">
                  <div class="skill-icon-wrapper">
                    <!-- C# Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline><line x1="12" y1="4" x2="12" y2="20"></line></svg>
                  </div>
                  <span class="skill-name">C#</span>
                </div>
                <div class="skill-item">
                  <div class="skill-icon-wrapper">
                    <!-- Git Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 15V9a4 4 0 0 0-4-4H9"></path><line x1="6" y1="9" x2="6" y2="15"></line></svg>
                  </div>
                  <span class="skill-name">Git</span>
                </div>
                <div class="skill-item">
                  <div class="skill-icon-wrapper">
                    <!-- Game Systems Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple"><rect x="2" y="6" width="20" height="12" rx="2"></rect><path d="M6 12h4"></path><path d="M8 10v4"></path><line x1="15" y1="13" x2="15.01" y2="13"></line><line x1="18" y1="11" x2="18.01" y2="11"></line></svg>
                  </div>
                  <span class="skill-name">Game Systems</span>
                </div>
                <div class="skill-item">
                  <div class="skill-icon-wrapper">
                    <!-- Level Design Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple"><path d="M3 3v18h18"></path><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"></path></svg>
                  </div>
                  <span class="skill-name">Level Design</span>
                </div>
              </div>
            </div>

            <!-- Araçlar -->
            <div class="skills-category-block">
              <h3 class="category-title">Araçlar & Teknolojiler</h3>
              <div class="skills-grid">
                <div class="skill-item">
                  <div class="skill-icon-wrapper">
                    <!-- Blender Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path><path d="M2 12h20"></path></svg>
                  </div>
                  <span class="skill-name">Blender</span>
                </div>
                <div class="skill-item">
                  <div class="skill-icon-wrapper">
                    <!-- Photoshop Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="9" x2="15" y2="15"></line><line x1="15" y1="9" x2="9" y2="15"></line></svg>
                  </div>
                  <span class="skill-name">Photoshop</span>
                </div>
                <div class="skill-item">
                  <div class="skill-icon-wrapper">
                    <!-- Aseprite Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path><path d="M12 6v12"></path><path d="M8 10h8"></path><path d="M8 14h8"></path></svg>
                  </div>
                  <span class="skill-name">Aseprite</span>
                </div>
                <div class="skill-item">
                  <div class="skill-icon-wrapper">
                    <!-- VS Code Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple"><path d="m18 16 4-4-4-4"></path><path d="m6 8-4 4 4 4"></path><path d="m14.5 4-5 16"></path></svg>
                  </div>
                  <span class="skill-name">Visual Studio</span>
                </div>
                <div class="skill-item">
                  <div class="skill-icon-wrapper">
                    <!-- ASP.NET Core Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
                  </div>
                  <span class="skill-name">ASP.NET Core</span>
                </div>
                <div class="skill-item">
                  <div class="skill-icon-wrapper">
                    <!-- Kotlin Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple"><path d="M2 2h20v20H2z"></path><path d="M2 22L22 2"></path><path d="M2 12h10l10 10"></path></svg>
                  </div>
                  <span class="skill-name">Kotlin / React</span>
                </div>
              </div>
            </div>

            <!-- Diğer -->
            <div class="skills-category-block">
              <h3 class="category-title">Diğer</h3>
              <div class="skills-grid">
                <div class="skill-item">
                  <div class="skill-icon-wrapper">
                    <!-- Problem Solving Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                  </div>
                  <span class="skill-name">Problem Solving</span>
                </div>
                <div class="skill-item">
                  <div class="skill-icon-wrapper">
                    <!-- Creativity Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .6 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg>
                  </div>
                  <span class="skill-name">Creativity</span>
                </div>
                <div class="skill-item">
                  <div class="skill-icon-wrapper">
                    <!-- Teamwork Icon -->
