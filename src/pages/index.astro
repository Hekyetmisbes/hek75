---
// src/pages/index.astro
// Welcome / Start page of the Hek75 portfolio site.
// Renders the glowing hero layout and links to the projects page.

import Layout from '../layouts/Layout.astro';
---

<Layout title="Harun Emrecan Karabağ | Game Developer" description="Harun Emrecan Karabağ - Computer Engineer and Game Developer portfolio welcome page.">
  <!-- Hero Section -->
  <section id="hero" class="hero-section">
    <div class="hero-bg-overlay"></div>
    <div class="container hero-content">
      <p class="hero-greeting text-purple">Merhaba, ben</p>
      <h1 class="hero-title">Harun Emrecan <br class="mobile-only"/><span class="text-purple glow-text">Karabağ</span></h1>
      <p class="hero-subtitle text-purple-light font-black">Game Developer</p>
      <p class="hero-desc">
        Oyun geliştirmeye tutkulu bir geliştirici. Etkileyici dünyalar ve unutulmaz deneyimler oluşturuyorum.
      </p>
      <div class="hero-actions">
        <a href="/projeler/" class="btn btn-primary">Projelerimi Gör <span class="arrow-icon">→</span></a>
      </div>
      
      <!-- Social Links -->
      <div class="hero-socials">
        <a href="https://github.com/Hekyetmisbes" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
        </a>
        <a href="https://www.linkedin.com/in/harunemrecankarabag/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
        <a href="mailto:harunemrecankarabag@gmail.com" aria-label="E-posta">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </a>
      </div>
    </div>

    <div class="scroll-down-arrow">
      <a href="/projeler/" aria-label="Aşağı Kaydır">
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
      </a>
    </div>
  </section>
</Layout>

<style>
  /* Hero Specific Styling */
  .hero-section {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background-image: url('/assets/hero_background.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero-bg-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, rgba(8, 9, 13, 0.45) 0%, rgba(8, 9, 13, 0.95) 90%), rgba(8, 9, 13, 0.5);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 750px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 4rem;
  }

  .hero-greeting {
    font-size: 1.125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 0.75rem;
  }

  .hero-title {
    font-size: 4.5rem;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    color: #ffffff;
  }

  .glow-text {
    text-shadow: 0 0 30px rgba(168, 85, 247, 0.6);
  }

  .hero-subtitle {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
  }

  .hero-desc {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 580px;
    margin: 0 auto 2.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .hero-socials {
    display: flex;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .hero-socials a {
    color: var(--text-secondary);
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .hero-socials a:hover {
    color: var(--accent-purple);
    transform: translateY(-2px);
  }

  .scroll-down-arrow {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    animation: bounce 2s infinite;
  }

  .scroll-down-arrow a {
    color: var(--text-secondary);
    transition: color 0.3s ease;
  }

  .scroll-down-arrow a:hover {
    color: var(--accent-purple);
  }

  .arrow-icon {
    margin-left: 0.5rem;
    transition: transform 0.3s ease;
  }

  .btn-primary:hover .arrow-icon {
    transform: translateX(3px);
  }

  .mobile-only {
    display: none;
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
      transform: translate(-50%, 0);
    }
    40% {
      transform: translate(-50%, -10px);
    }
    60% {
      transform: translate(-50%, -5px);
    }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 3rem;
    }
    .mobile-only {
      display: inline;
    }
  }
</style>
