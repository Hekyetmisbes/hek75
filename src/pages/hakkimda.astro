---
// src/pages/hakkimda.astro
// Biography page with stats and CV download link.

import Layout from '../layouts/Layout.astro';
---

<Layout title="Hakkımda | Harun Emrecan Karabağ" description="Harun Emrecan Karabağ - Biyografi, oyun geliştirme tutkusu, deneyim ve istatistikleri.">
  <section class="section border-none">
    <div class="container">
      <h2 class="section-title text-left">Hakkımda</h2>
      
      <div class="about-grid">
        <div class="about-text-col">
          <p class="about-paragraph text-highlight">
            Merhaba! Ben Harun Emrecan Karabağ. Oyun geliştirmeye olan ilgim, küçük yaşlarda başladı ve zamanla tutkum haline geldi.
          </p>
          <p class="about-paragraph">
            Unity ve Unreal Engine ile 3D ve 2D oyunlar geliştiriyorum. Oyun mekanikleri, seviye tasarımı (level design), yapay zeka ve oyuncu deneyimi (player experience) üzerine odaklanıyorum. Bilgisayar mühendisliği altyapımla performans odaklı, temiz ve sürdürülebilir kod yazmayı ilke ediniyorum.
          </p>
          <p class="about-paragraph">
            Yeni oyun motoru araçları, optimizasyon teknikleri ve modern yazılım mimarileri öğrenmeyi, yaratıcı projeler üreterek oyun dünyasında kalıcı izler bırakmayı hedefliyorum.
          </p>
          <div class="about-cv-action">
            <a href="/assets/Harun-Emrecan-Karabag-CV.pdf" target="_blank" class="btn btn-outline">
              Özgeçmişimi İndir <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-icon"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            </a>
          </div>
        </div>
        
        <div class="about-img-col">
          <div class="about-image-wrapper">
            <img src="/assets/about_profile.png" alt="Harun Emrecan Karabağ" loading="lazy" />
          </div>
        </div>
      </div>

      <!-- Character Stats -->
      <div class="stats-row">
        <div class="stat-box">
          <span class="stat-number">3+</span>
          <span class="stat-label">Yıl Deneyim</span>
        </div>
        <div class="stat-box">
          <span class="stat-number">6+</span>
          <span class="stat-label">Tamamlanan Proje</span>
        </div>
        <div class="stat-box">
          <span class="stat-number">2+</span>
          <span class="stat-label">Oyun Jam</span>
        </div>
        <div class="stat-box">
          <span class="stat-number">∞</span>
          <span class="stat-label">Kahve</span>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.9fr;
    gap: 3.5rem;
    align-items: center;
    margin-bottom: 4.5rem;
  }

  .about-paragraph {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }

  .text-highlight {
    color: #ffffff;
    font-size: 1.1875rem;
    font-weight: 500;
  }

  .about-cv-action {
    margin-top: 2rem;
  }

  .about-img-col {
    display: flex;
    justify-content: center;
  }

  .about-image-wrapper {
    position: relative;
    max-width: 320px;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border-color);
  }

  .about-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .about-image-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    box-shadow: inset 0 0 30px rgba(168, 85, 247, 0.15);
    pointer-events: none;
    border-radius: 16px;
  }

  .about-image-wrapper:hover img {
    transform: scale(1.03);
  }

  /* Stats Section Row */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--border-color);
  }

  .stat-box {
    background: var(--bg-panel);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1.75rem 1.25rem;
    text-align: center;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .stat-box:hover {
    border-color: var(--border-hover);
    box-shadow: 0 5px 20px var(--accent-purple-glow);
  }

  .stat-number {
    display: block;
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--accent-purple);
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .inline-icon {
    margin-left: 0.35rem;
    vertical-align: middle;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .about-img-col {
      order: -1;
    }

    .stats-row {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .stats-row {
      grid-template-columns: 1fr;
    }
  }
</style>
