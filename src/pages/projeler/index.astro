---
// src/pages/projeler/index.astro
// Projects list page with dynamic filtering tabs and card grid.

import Layout from '../../layouts/Layout.astro';

const projects = [
  {
    title: "The Final Loop",
    genre: "Psychological Puzzle / Vertical Slice",
    engine: "Unreal Engine",
    desc: "Unreal Engine ile geliştirilmiş psikolojik bulmaca oyunu. Karanlık bir araştırma tesisinde hafıza döngülerini keşfedin ve odalardan kaçış bulmacalarını çözün.",
    slug: "the-final-loop",
    category: "oyunlar",
    year: "2026",
    image: "/assets/echoes.png"
  },
  {
    title: "The Unlit Door",
    genre: "Psychological Puzzle / Pitch",
    engine: "Unity",
    desc: "Psikolojik ve anlatı odaklı bir bulmaca oyunu projesi için hazırlanan, konsept ve atmosfer detaylarını içeren yazılı pitch sayfası.",
    slug: "the-unlit-door",
    category: "diger",
    year: "2025",
    image: "/assets/luma.png"
  },
  {
    title: "Delivery Driver",
    genre: "3D Simulation",
    engine: "Unity",
    desc: "Şehir içinde siparişleri zamanında teslim etmeye çalıştığınız eğlenceli bir Unity 3D simülasyon ve sürüş oyunu.",
    slug: "delivery-driver",
    category: "oyunlar",
    year: "2024",
    image: "/assets/tiny_survivor.png"
  },
  {
    title: "Fog Bridge",
    genre: "Atmospheric Narrative Puzzle",
    engine: "Unity",
    desc: "GameDev.tv Game Jam 2026 için geliştirilen, sisler arasından gelen kağıt uçaklardaki mesajları çözerek köprüyü yeniden kurduğunuz atmosferik bulmaca oyunu.",
    slug: "fog-bridge",
    category: "jam",
    year: "2026",
    image: "/assets/hero_background.png"
  },
  {
    title: "Movidle Game",
    genre: "Web Game / Puzzle",
    engine: "Unity",
    desc: "IMDb Top 250 listesindeki filmleri tahmin etmeye çalıştığınız, renk kodlu ipuçları sunan eğlenceli bir Unity web bulmaca oyunu.",
    slug: "movidle-game",
    category: "oyunlar",
    year: "2025",
    image: "/assets/orbital.png"
  },
  {
    title: "Flag Quiz Game",
    genre: "Mobile Quiz / Educational",
    engine: "Unity",
    desc: "Oyuncuların coğrafya bilgisini geliştirmesini hedefleyen, Unity ve C# ile mobil cihazlar için optimize edilmiş bayrak tahmin oyunu.",
    slug: "flag-quiz-game",
    category: "oyunlar",
    year: "2023",
    image: "/assets/luma.png"
  }
];
---

<Layout title="Projelerim | Harun Emrecan Karabağ" description="Harun Emrecan Karabağ'ın Unity ve Unreal Engine ile geliştirdiği oyunlar ve diğer projeleri.">
  <section class="section border-none">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Projelerim</h2>
        <div class="filter-tabs">
          <button class="filter-tab active" data-filter="all">Tümü</button>
          <button class="filter-tab" data-filter="oyunlar">Oyunlar</button>
          <button class="filter-tab" data-filter="jam">Oyun Jam</button>
          <button class="filter-tab" data-filter="diger">Diğer</button>
        </div>
      </div>

      <div class="projects-grid">
        {projects.map((project) => (
          <article class="project-card" data-category={project.category} data-slug={project.slug}>
            <div class="project-img-wrapper">
              <img src={project.image} alt={project.title} loading="lazy" />
              <div class="project-overlay">
                <span class="btn-detail">Projeyi İncele ↗</span>
              </div>
            </div>
            <div class="project-info">
              <div class="project-meta">
                <span class="project-genre">{project.genre}</span>
                <span class="project-year">{project.year}</span>
              </div>
              <h3 class="project-card-title">{project.title}</h3>
              <p class="project-desc">{project.desc}</p>
              <div class="project-card-footer">
                <span class="project-engine">{project.engine}</span>
                <a href={`/projeler/${project.slug}/`} class="project-link-icon" aria-label={`${project.title} detay sayfasını aç`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  // Project Filtering Logic
  const tabs = document.querySelectorAll('.filter-tab');
  const cards = document.querySelectorAll('.project-card');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');

      const filter = tab.getAttribute('data-filter');

      cards.forEach((card) => {
        const cardEl = card as HTMLElement;
        const category = cardEl.getAttribute('data-category');

        if (filter === 'all' || filter === category) {
          cardEl.style.display = 'flex';
          cardEl.style.opacity = '0';
          setTimeout(() => {
            cardEl.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
            cardEl.style.opacity = '1';
          }, 50);
        } else {
          cardEl.style.display = 'none';
        }
      });
    });
  });

  // Card click routing
  cards.forEach((card) => {
    card.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      // If clicked the direct anchor link icon, let the browser handle it
      if (target.closest('a')) return;
      
      const slug = card.getAttribute('data-slug');
      if (slug) {
        window.location.href = `/projeler/${slug}/`;
      }
    });
  });
</script>

<style>
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .section-header .section-title {
    margin-bottom: 0;
  }

  /* Filtering Tabs */
  .filter-tabs {
    display: flex;
    gap: 0.75rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    padding: 0.35rem;
    border-radius: 30px;
  }

  .filter-tab {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    padding: 0.5rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 700;
    border-radius: 20px;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
  }

  .filter-tab:hover {
    color: var(--text-primary);
  }

  .filter-tab.active {
    background: var(--accent-purple);
    color: #ffffff;
    box-shadow: 0 2px 10px rgba(168, 85, 247, 0.3);
  }

  /* Project Cards & Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.25rem;
  }

  .project-card {
    background: var(--bg-panel);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  .project-card:hover {
    border-color: var(--border-hover);
    box-shadow: 0 10px 30px var(--accent-purple-glow);
    transform: translateY(-4px);
  }

  .project-img-wrapper {
    position: relative;
    height: 220px;
    overflow: hidden;
  }

  .project-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-card:hover .project-img-wrapper img {
    transform: scale(1.05);
  }

  .project-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(8, 9, 13, 0.65);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card:hover .project-overlay {
    opacity: 1;
  }

  .btn-detail {
    color: #ffffff;
    font-weight: 700;
    font-size: 0.875rem;
    background: rgba(168, 85, 247, 0.95);
    padding: 0.65rem 1.25rem;
    border-radius: 30px;
    box-shadow: 0 4px 15px rgba(168, 85, 247, 0.4);
    transform: translateY(10px);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-card:hover .btn-detail {
    transform: translateY(0);
  }

  .project-info {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .project-genre {
    color: var(--accent-purple-light);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-year {
    color: var(--text-secondary);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .project-card-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .project-desc {
    color: var(--text-secondary);
    font-size: 0.9125rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .project-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.02);
  }

  .project-engine {
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    text-transform: uppercase;
  }

  .project-link-icon {
    color: var(--text-secondary);
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .project-card:hover .project-link-icon {
    color: var(--accent-purple);
    transform: translate(2px, -2px);
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
