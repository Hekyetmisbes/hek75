---
// src/pages/projeler/[slug].astro
// Dynamic project detail page rendering trailer, story, technologies, and specs.

import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projectsData = [
    {
      slug: "the-final-loop",
      title: "The Final Loop",
      genre: "Psychological Puzzle / Vertical Slice",
      engine: "Unreal Engine 5",
      tech: ["C++", "Blueprints", "Unreal Audio", "Niagara VFX"],
      year: "2026",
      teamSize: "1 (Tek Geliştirici)",
      image: "/assets/echoes.png",
      videoCover: "/assets/echoes.png",
      story: "Karanlık bir askeri araştırma tesisinde uyanan deneysel bir deneğin hikayesi. Tesis çökerken, kendinizi bitmek bilmeyen bir zaman döngüsünün (memory loop) içinde buluyorsunuz. Her döngüde odalardaki ipuçlarını birleştirerek tesisin sırrını çözmeli ve kaçış yolunu bulmalısınız.",
      features: [
        { title: "Hafıza Döngüleri", desc: "Zaman sıfırlandığında değişen çevre koşulları, açılan yeni yollar ve döngüye rağmen kalıcı olan bulmaca durumları." },
        { title: "Kaçış Odası Mekanikleri", desc: "Etkileşimli terminal arayüzleri, şifre çözme, gizli belgeler ve fizik tabanlı bulmaca tasarımları." },
        { title: "Gerilim Dolu Atmosfer", desc: "Unreal Engine 5 kalitesinde volumetrik sisler, dinamik ışıklandırmalar ve 3D uzamsal ses tasarımıyla yaratılan klostrofobik his." }
      ],
      links: {
        github: "https://github.com/Hekyetmisbes",
        itch: "",
        presentation: "/projects/thefinalloop/"
      }
    },
    {
      slug: "the-unlit-door",
      title: "The Unlit Door",
      genre: "Psychological Puzzle / Pitch",
      engine: "Unity (URP)",
      tech: ["C#", "ScriptableObjects", "Cinemachine", "Post-Processing"],
      year: "2025",
      teamSize: "1 (Tek Geliştirici)",
      image: "/assets/luma.png",
      videoCover: "/assets/luma.png",
      story: "Karanlık ve aydınlık temaları etrafında şekillenen, oyuncunun zihnindeki odaları sembolize eden kapıları açmaya çalıştığı psikolojik bir anlatı bulmaca oyunu konsepti. Bu sayfa, oyunun atmosferini, pazar araştırmasını ve geliştirme süreçlerinin planlamasını içeren detaylı bir Written Pitch sunumudur.",
      features: [
        { title: "Anlatı Odaklı Bulmacalar", desc: "Hikaye anlatımıyla iç içe geçmiş, oyuncunun kararlarına ve zihinsel durumuna göre şekillenen soyut bulmacalar." },
        { title: "Işık ve Gölge Kontrolü", desc: "Görünmeyen yolları aydınlatmak, gizli kapıları açmak ve tehlikelerden kaçınmak için ışığı bir araç olarak kullanma mekaniği." },
        { title: "Detaylı Pazar Analizi", desc: "Gantt şemaları, pazar analizleri, hedef kitle davranışları ve finansal planlamaları içeren profesyonel sunum dosyaları." }
      ],
      links: {
        github: "https://github.com/Hekyetmisbes",
        itch: "",
        presentation: "/projects/theunlitdoor/"
      }
    },
    {
      slug: "delivery-driver",
      title: "Delivery Driver",
      genre: "3D Simulation & Sürüş",
      engine: "Unity",
      tech: ["C#", "Unity Physics", "New Input System"],
      year: "2024",
      teamSize: "1 (Tek Geliştirici)",
      image: "/assets/tiny_survivor.png",
      videoCover: "/assets/tiny_survivor.png",
      story: "Şehir trafiğinde bir kurye olarak kargoları en hızlı ve güvenli şekilde hedefe ulaştırmaya çalıştığınız, fizik tabanlı bir kurye simülasyon oyunu. Trafik kurallarına uymak veya kestirme yollardan gitmek tamamen sizin kuryelik stratejinize kalmış!",
      features: [
        { title: "Fizik Tabanlı Sürüş", desc: "Araç kontrolü, ani frenlemeler, virajlarda paketlerin savrulması ve hasar alma gibi gerçekçi fizik etkileşimleri." },
        { title: "Dinamik Teslimat Noktaları", desc: "Şehir genelinde rastgele oluşturulan kurye görevleri ve süre kısıtlamasına karşı heyecan dolu yarış." },
        { title: "Yeni Giriş Sistemi", desc: "Gamepad ve klavye kontrolleri için tamamen optimize edilmiş New Input System entegrasyonu." }
      ],
      links: {
        github: "https://github.com/Hekyetmisbes/delivery-driver",
        itch: "https://hekyetmisbes.itch.io/delivery-driver",
        presentation: ""
      }
    },
    {
      slug: "fog-bridge",
      title: "Fog Bridge",
      genre: "Atmospheric Narrative Puzzle",
      engine: "Unity",
      tech: ["C#", "Cinemachine", "URP 2D Light", "Custom Audio Controller"],
      year: "2026",
      teamSize: "1 (Tek Geliştirici)",
      image: "/assets/hero_background.png",
      videoCover: "/assets/hero_background.png",
      story: "GameDev.tv Game Jam 2026 için 72 saatte geliştirilmiş atmosferik bir bulmaca oyunu. Uçsuz bucaksız bir sis denizinin ortasında, kağıt uçaklarla gelen şifreli mektupları deşifre ederek karşı tarafa uzanan sis köprüsünü parça parça inşa etmeye çalışıyorsunuz.",
      features: [
        { title: "Kağıt Uçak Mesajları", desc: "Sisin içinden süzülüp gelen uçaklardaki gizemli sembolleri çözerek köprünün bir sonraki parçasını yerleştirme mekaniği." },
        { title: "2D Işık ve Atmosfer", desc: "Unity URP 2D ışıkları kullanılarak tasarlanmış, melankolik, minimalist ve sürreal sis atmosferi." },
        { title: "Jam Kısıtlamaları", desc: "72 saatlik kısıtlı sürede tamamlanmış, yüksek performanslı ve odaklanmış temiz oyun mekanikleri." }
      ],
      links: {
        github: "https://github.com/Hekyetmisbes",
        itch: "https://hekyetmisbes.itch.io/fog-bridge",
        presentation: ""
      }
    },
    {
      slug: "movidle-game",
      title: "Movidle Game",
      genre: "Web Game / Puzzle",
      engine: "Unity (WebGL)",
      tech: ["C#", "JSON Parsing", "IMDb API integration", "Responsive WebGL UI"],
      year: "2025",
      teamSize: "1 (Tek Geliştirici)",
      image: "/assets/orbital.png",
      videoCover: "/assets/orbital.png",
      story: "IMDb Top 250 listesindeki popüler filmleri tahmin etmeye çalıştığınız Wordle benzeri bir kelime ve sinema bulmaca oyunu. Her tahminde filmin yönetmeni, yılı, türü ve oyuncu kadrosuna dair renk kodlu ipuçları alırsınız.",
      features: [
        { title: "Wordle Mekaniği", desc: "Renk kodlu (yeşil, sarı, gri) kutularla hedefe ne kadar yaklaştığınızı (yönetmen, yıl, oyuncular bazında) gösteren ipuçları." },
        { title: "IMDb Top 250 Veri Tabanı", desc: "250 efsanevi filmden oluşan ve yerel JSON dosyaları üzerinden beslenen hızlı ve çevrimdışı veri tabanı." },
        { title: "WebGL Optimizasyonu", desc: "Mobil ve masaüstü tarayıcılarda anında yüklenen, optimize edilmiş bellek tüketimine sahip WebGL derlemesi." }
      ],
      links: {
        github: "https://github.com/Hekyetmisbes/movidle",
        itch: "",
        presentation: ""
      }
    },
    {
      slug: "flag-quiz-game",
      title: "Flag Quiz Game",
      genre: "Mobile Quiz / Educational",
      engine: "Unity",
      tech: ["C#", "UI Toolkit", "ShaderLab Custom Effects", "Local Storage Save System"],
      year: "2023",
      teamSize: "1 (Tek Geliştirici)",
      image: "/assets/luma.png",
      videoCover: "/assets/luma.png",
      story: "Dünya ülkelerinin bayraklarını eğlenceli oyun modlarıyla öğrenmenizi sağlayan eğitici ve dinamik bir mobil bilgi yarışması oyunu. Zaman sınırı, can sistemi ve yüksek skor takibi ile oyuncu bağlılığı hedeflenmiştir.",
      features: [
        { title: "Çoklu Oyun Modu", desc: "Zamana karşı yarış, sonsuz mod ve bayraktan ülke bulma gibi çeşitli modlarla zengin oyun deneyimi." },
        { title: "Shader Efektleri", desc: "Cevap verildiğinde bayrak kartları üzerinde tetiklenen custom shader parlamaları ve geçiş efektleri." },
        { title: "Mobil Uyumlu Arayüz", desc: "Farklı ekran en-boy oranları için tamamen esnek (responsive) mobil UI tasarımı ve yerel veri kaydetme sistemi." }
      ],
      links: {
        github: "https://github.com/Hekyetmisbes/flag-quiz-game",
        itch: "",
        presentation: ""
      }
    }
  ];

  return projectsData.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} | Proje Detayı`} description={project.story}>
  <section class="section border-none detail-page">
    <div class="container">
      <!-- Back button -->
      <a href="/projeler/" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-icon"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Tüm Projelere Dön
      </a>

      <!-- Project Header Info -->
      <div class="detail-header">
        <span class="project-tag-genre">{project.genre}</span>
        <h1 class="project-detail-title">{project.title}</h1>
      </div>

      <!-- Main Columns -->
      <div class="detail-grid">
        <!-- Main Column: Video & Story -->
        <div class="detail-main-col">
          <!-- Trailer Video Mockup -->
          <div class="video-container">
            <div class="video-overlay" id="videoOverlay">
              <img src={project.videoCover} alt="Trailer Cover Image" class="video-cover-img" />
              <div class="play-button-wrapper">
                <div class="play-button-glow"></div>
                <button class="play-button" aria-label="Fragmanı Oynat" id="playBtn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="currentColor" class="text-white"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                </button>
              </div>
              <span class="video-label">Fragmanı İzle</span>
            </div>
            
            <!-- Hidden video iframe or local video tag (simulated player) -->
            <div class="simulated-player" id="simPlayer" style="display: none;">
              <video id="localVideo" width="100%" height="100%" controls poster={project.videoCover}>
                <source src="https://assets.mixkit.co/videos/preview/mixkit-futuristic-digital-particles-loop-31835-large.mp4" type="video/mp4" />
                Tarayıcınız video oynatmayı desteklemiyor.
              </video>
            </div>
          </div>

          <!-- Story Section -->
          <div class="story-section">
            <h2 class="sub-title">Hikaye & Konsept</h2>
            <p class="story-text">{project.story}</p>
          </div>

          <!-- Key Features Section -->
          <div class="features-section">
            <h2 class="sub-title">Öne Çıkan Özellikler</h2>
            <div class="features-list">
              {project.features.map((f) => (
                <div class="feature-item">
                  <div class="feature-marker"></div>
                  <div class="feature-info">
                    <h3 class="feature-title">{f.title}</h3>
                    <p class="feature-desc">{f.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar: Spec Details & Actions -->
        <div class="detail-sidebar-col">
          <div class="spec-card">
            <h3 class="spec-card-title">Proje Detayları</h3>
            
            <div class="spec-list">
              <div class="spec-row">
                <span class="spec-label">Oyun Motoru</span>
                <span class="spec-val text-white">{project.engine}</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">Yapım Yılı</span>
                <span class="spec-val text-white">{project.year}</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">Ekip / Rol</span>
                <span class="spec-val text-white">{project.teamSize}</span>
              </div>
            </div>

            <div class="tech-tags-wrapper">
              <h4 class="tech-title">Kullanılan Teknolojiler</h4>
              <div class="tech-tags">
                {project.tech.map((t) => (
                  <span class="tech-tag">{t}</span>
                ))}
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="action-buttons">
              {project.links.itch && (
                <a href={project.links.itch} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-full">
                  Itch.io'da Oyna ↗
                </a>
              )}
              {project.links.github && (
                <a href={project.links.github} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-full">
                  GitHub'da İncele
                </a>
              )}
              {project.links.presentation && (
                <a href={project.links.presentation} class="btn btn-primary btn-full glow-btn">
                  Detaylı Sunum Sayfası ↗
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Simple Video Play Simulation
  const playBtn = document.getElementById('playBtn');
  const videoOverlay = document.getElementById('videoOverlay');
  const simPlayer = document.getElementById('simPlayer');
  const localVideo = document.getElementById('localVideo') as HTMLVideoElement;

  if (playBtn && videoOverlay && simPlayer && localVideo) {
    playBtn.addEventListener('click', () => {
      videoOverlay.style.display = 'none';
      simPlayer.style.display = 'block';
      localVideo.play();
    });
  }
</script>

<style>
  .detail-page {
    padding-top: 8rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2rem;
    transition: color 0.3s ease;
  }

  .back-link:hover {
    color: var(--accent-purple);
  }

  .back-link .inline-icon {
    margin-right: 0.5rem;
  }

  .detail-header {
    margin-bottom: 3rem;
  }

  .project-tag-genre {
    color: var(--accent-purple-light);
    font-size: 0.8125rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .project-detail-title {
    font-size: 3rem;
    font-weight: 900;
    color: #ffffff;
  }

  /* Grid Columns */
  .detail-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: 3.5rem;
    align-items: start;
  }

  /* Video Trailer Container */
  .video-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    background: #000;
    margin-bottom: 3.5rem;
  }

  .video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 10;
    cursor: pointer;
  }

  .video-cover-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.4;
    transition: transform 0.5s ease;
  }

  .video-overlay:hover .video-cover-img {
    transform: scale(1.03);
  }

  .play-button-wrapper {
    position: relative;
    z-index: 12;
    width: 80px;
    height: 80px;
    margin-bottom: 1rem;
  }

  .play-button {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--accent-purple);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    cursor: pointer;
    box-shadow: 0 0 20px rgba(168, 85, 247, 0.6);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .play-button-glow {
    position: absolute;
    top: -5px;
    left: -5px;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: transparent;
    border: 2px solid var(--accent-purple);
    opacity: 0.5;
    animation: pulse-glow 2s infinite;
  }

  .video-overlay:hover .play-button {
    background: #b56ff8;
    transform: scale(1.1);
    box-shadow: 0 0 30px rgba(168, 85, 247, 0.9);
  }

  .video-label {
    position: relative;
    z-index: 12;
    color: #ffffff;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
  }

  .simulated-player {
    width: 100%;
    height: 100%;
  }

  @keyframes pulse-glow {
    0% {
      transform: scale(0.95);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.15);
      opacity: 0;
    }
    100% {
      transform: scale(0.95);
      opacity: 0;
    }
  }

  /* Subtitles */
  .sub-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 1.5rem;
    position: relative;
    padding-left: 0.75rem;
  }

  .sub-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 14px;
    background: var(--accent-purple);
    border-radius: 2px;
  }

  /* Story section */
  .story-section {
    margin-bottom: 3.5rem;
  }

  .story-text {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Features section */
  .features-section {
    margin-bottom: 3.5rem;
  }

  .features-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .feature-item {
    display: flex;
    gap: 1.25rem;
    align-items: start;
  }

  .feature-marker {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-purple);
    box-shadow: 0 0 8px var(--accent-purple);
    margin-top: 0.55rem;
    flex-shrink: 0;
  }

  .feature-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.25rem;
  }

  .feature-desc {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* Specs Sidebar Card */
  .spec-card {
    background: var(--bg-panel);
    border: 1px solid var(--border-color);
    padding: 2.25rem;
    border-radius: 12px;
    position: sticky;
    top: 6.5rem;
  }

  .spec-card-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 1.75rem;
  }

  .spec-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9375rem;
  }

  .spec-label {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .spec-val {
    font-weight: 700;
  }

  .tech-tags-wrapper {
    margin-bottom: 2.5rem;
  }

  .tech-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .tech-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tech-tag {
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    text-transform: uppercase;
  }

  /* Action Buttons */
  .action-buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .btn-full {
    width: 100%;
    justify-content: center;
  }
  
  .glow-btn {
    box-shadow: 0 4px 20px rgba(168, 85, 247, 0.55);
  }

  .inline-icon {
    vertical-align: middle;
  }

  @media (max-width: 900px) {
    .detail-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 480px) {
    .project-detail-title {
      font-size: 2.25rem;
    }
  }
</style>
